{
  "name": "mailbox-plus-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd astro && npm run dev",
    "build": "cd astro && npm run build",
    "preview": "cd astro && npm run preview",
    "check": "cd astro && npm run check",
    "typecheck": "cd astro && npm run check",
    "test": "cd astro && npm test",
    "test:watch": "cd astro && npm run test:watch",
    "lint": "eslint .",
    "audit:micro-problems": "node scripts/audit-micro-problems.cjs",
    "audit:micro-problems:report": "node scripts/audit-micro-problems.cjs",
    "test:retrieval": "tsx knowledge/retrieval-test-runner.ts",
    "build:embeddings": "tsx scripts/build-embeddings.ts",
    "audit:articles": "node scripts/validate-articles.cjs",
    "generate:article-sitemap": "node scripts/generate-article-sitemap.cjs",
    "seo:check-routes": "node scripts/seo/check-route-registry.mjs",
    "seo:check-links": "node scripts/seo/check-internal-link-strategy.mjs",
    "seo:check-jsonld": "node scripts/seo/check-jsonld-absolute-urls.mjs",
    "seo:check-canonical": "node scripts/seo/check-canonical-slash.mjs",
    "seo:check-href-slash": "node scripts/seo/check-internal-href-slash.mjs",
    "check:public-data": "bash scripts/check-public-data-refs.sh",
    "prepare": "husky || true",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@netlify/blobs": "^10.7.9",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.14.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
