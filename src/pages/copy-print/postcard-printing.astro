---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { PostcardPrinting } from '../../page-components/PostcardPrinting';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/copy-print/postcard-printing'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={PostcardPrinting} client:only="react" />
</Layout>
