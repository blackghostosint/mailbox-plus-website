---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { BusinessCardsPage } from '../../page-components/BusinessCardsPage';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/copy-print/business-cards'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={BusinessCardsPage} client:only="react" />
</Layout>
