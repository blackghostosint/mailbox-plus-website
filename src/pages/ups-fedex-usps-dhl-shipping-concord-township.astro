---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import MultiCarrierShippingPage from '../page-components/ups-fedex-usps-dhl-shipping-concord-township';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/ups-fedex-usps-dhl-shipping-concord-township'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={MultiCarrierShippingPage} client:only="react" />
</Layout>
