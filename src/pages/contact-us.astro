---
import ContactUsIsland from '../page-islands/ContactUsIsland';
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';

const meta = pageMeta['/contact-us'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <ContactUsIsland client:only="react" />
</Layout>
