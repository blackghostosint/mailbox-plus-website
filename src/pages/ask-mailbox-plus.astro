---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import AskMailboxPlus from '../page-components/ask-mailbox-plus';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/ask-mailbox-plus'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={AskMailboxPlus} client:only="react" />
</Layout>
