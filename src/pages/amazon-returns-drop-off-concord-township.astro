---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import AmazonReturnsPage from '../page-components/amazon-returns-drop-off-concord-township';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/amazon-returns-drop-off-concord-township'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={AmazonReturnsPage} client:only="react" />
</Layout>
