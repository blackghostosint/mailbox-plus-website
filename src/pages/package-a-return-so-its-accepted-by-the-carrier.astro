import { pageMeta } from '../config/pageMeta';
import { MicroProblemContent } from '../page-components/micro/MicroProblemPage';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/package-a-return-so-its-accepted-by-the-carrier'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
