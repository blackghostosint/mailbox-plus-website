---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { DocumentScanning } from '../../page-components/DocumentScanning';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/home-business/document-scanning'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={DocumentScanning} client:only="react" />
</Layout>
