---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { EveryDoorDirectMail } from '../../page-components/EveryDoorDirectMail';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/home-business/every-door-direct-mail'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

