---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { MailboxRentalPage } from '../../page-components/MailboxRentalPage';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/home-business/mailbox-rental'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={MailboxRentalPage} client:only="react" />
</Layout>
