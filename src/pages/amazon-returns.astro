---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import { AmazonReturnGuide } from '../page-components/AmazonReturnGuide';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/amazon-returns'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={AmazonReturnGuide} client:only="react" />
</Layout>
