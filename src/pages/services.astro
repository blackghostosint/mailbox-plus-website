---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import { Services as ServicesPage } from '../page-components/Services';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/services'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={ServicesPage} client:only="react" />
</Layout>
