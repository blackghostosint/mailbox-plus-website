---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import { AboutUs as AboutUsPage } from '../page-components/AboutUs';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/about-us'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={AboutUsPage} client:only="react" />
</Layout>
