---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { PackageDropOffs } from '../../page-components/PackageDropOffs';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/pack-ship/package-drop-offs'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={PackageDropOffs} client:only="react" />
</Layout>
