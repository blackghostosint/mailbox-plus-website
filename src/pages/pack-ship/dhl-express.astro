---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { DHLExpress } from '../../page-components/DHLExpress';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/pack-ship/dhl-express'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={DHLExpress} client:only="react" />
</Layout>
