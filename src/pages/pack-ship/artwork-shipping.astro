---
import Layout from '../../layouts/Layout.astro';
import { pageMeta } from '../../config/pageMeta';
import { ArtworkShipping as ArtworkShippingPage } from '../../page-components/ArtworkShipping';
import { WithProviders } from '../../page-components/WithProviders';

const meta = pageMeta['/pack-ship/artwork-shipping'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={ArtworkShippingPage} client:only="react" />
</Layout>
