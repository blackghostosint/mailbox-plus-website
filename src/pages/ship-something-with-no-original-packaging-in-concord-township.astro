---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import { MicroProblemContent } from '../page-components/micro/MicroProblemPage';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/ship-something-with-no-original-packaging-in-concord-township'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={MicroProblemContent} slug="/ship-something-with-no-original-packaging-in-concord-township" client:only="react" />
</Layout>
