---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';
import { FedExEasyReturns } from '../page-components/fedex-easy-returns';
import { WithProviders } from '../page-components/WithProviders';

const meta = pageMeta['/fedex-easy-returns'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <WithProviders component={FedExEasyReturns} client:only="react" />
</Layout>
