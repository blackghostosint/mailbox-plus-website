---
import TrackingIsland from '../page-islands/TrackingIsland';
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';

const meta = pageMeta['/tracking'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <TrackingIsland client:only="react" />
</Layout>
