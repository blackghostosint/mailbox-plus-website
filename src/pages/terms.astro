---
import TermsIsland from '../page-islands/TermsIsland';
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../config/pageMeta';

const meta = pageMeta['/terms'] ?? { title: 'Mailbox Plus Ohio', description: 'Community-focused pack & ship retail store in Concord Township, Ohio.' };
---

<Layout title={meta.title} description={meta.description} schema={meta.schema}>
    <TermsIsland client:only="react" />
</Layout>
