# Environment Variables for Mailbox Plus Website
# Copy this file to `.env` and fill in the values
# NEVER commit the actual `.env` file (it's in .gitignore)

# Cloudflare R2 Public Bucket URL (for images)
VITE_R2_PUBLIC_BASE_URL=https://pub-21518ce3034449a3a7b5a0b89551f710.r2.dev

# Gemini AI API Key (for chatbot functionality)
# Get from: https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# reCAPTCHA Site Key (for contact forms)
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Site URL (set automatically by Netlify context)
# SITE_URL=https://mailboxplusohio.com  # Production
# SITE_URL=https://staging.mailboxplusohio.com  # Staging

# Stripe Secret Key (for create-checkout Netlify function — direct-to-Stripe mailbox checkout)
# Get from: https://dashboard.stripe.com/apikeys (live mode secret key, sk_live_...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
