# Environment Variables for Mailbox Plus Website
# Copy this file to `.env` and fill in the values
# NEVER commit the actual `.env` file (it's in .gitignore)

# ------------------------------------------------------------------------------
# 1. Client Build & Frontend Assets (Vite)
# ------------------------------------------------------------------------------

# Cloudflare R2 Public Bucket URL (for images)
VITE_R2_PUBLIC_BASE_URL=https://pub-21518ce3034449a3a7b5a0b89551f710.r2.dev

# Google Maps API Key (for embed map)
# VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# reCAPTCHA Site Key (for public contact and accessibility forms)
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Netlify Deployment Context exposed to Vite client ('production', 'deploy-preview', 'branch-deploy')
# VITE_NETLIFY_CONTEXT=development

# Sentry DSN & Environment (optional error monitoring)
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. Netlify Serverless Functions & Backend API
# ------------------------------------------------------------------------------

# Netlify Blobs Credentials (required for serverless rate limiting, embedding cache, and reviews cache)
# Get from Netlify site settings or access token manager
# NETLIFY_SITE_ID=your_netlify_site_id_here
# NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here

# Google Places API Key (for fetching live business reviews in reviews Netlify function & prebuild)
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# reCAPTCHA Secret Key (server-only secret used by reCAPTCHA verification in sendEmail Netlify function)
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# reCAPTCHA Minimum Score Threshold (0.0 to 1.0, default 0.5)
# RECAPTCHA_MIN_SCORE=0.5

# Resend API Key (for contact form emails via sendEmail Netlify function)
# Get from: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here

# Destination Email (for contact form submissions)
CONTACT_EMAIL=help@mailboxplusohio.com

# Stripe Secret Key (for create-checkout and verify-session Netlify functions — direct-to-Stripe mailbox checkout)
# Get from: https://dashboard.stripe.com/apikeys (live mode secret key)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Site Base URL (set automatically by Netlify context or local dev server)
# SITE_URL=https://mailboxplusohio.com  # Production
# VITE_SITE_URL=https://mailboxplusohio.com  # Client override
# SITE_URL=http://localhost:8888        # Local Netlify dev

# Netlify Function Runtime Context ('production', 'deploy-preview', 'branch-deploy')
# CONTEXT=development

# Netlify Local Dev Server Flag ('true' or 'false')
# NETLIFY_DEV=true

# ------------------------------------------------------------------------------
# 3. Tooling, Knowledge Base & Pre-Flight Verification Scripts
# ------------------------------------------------------------------------------

# Gemini AI API Key (for knowledge retrieval test suite and embedding generation)
# Server secret — do NOT prefix with VITE_ (prevents inlining into client bundles)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API Request Timeout (in seconds)
# GEMINI_TIMEOUT_SECONDS=90

# OpenRouter / LLM Model API Keys (for direct-response article copy review in scripts/review-article-copy.ts)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# MODEL_API_KEY=your_model_api_key_here

# Accessibility Audit Base URL Overrides (used by scripts/audit-a11y.mjs)
# AUDIT_BASE_URL=http://localhost:4173
# BASE_URL=http://localhost:4173

# Distribution Build Output Directory Override (used by scripts/lib/dist-path.mjs)
# DIST_DIR=dist

# Pre-Flight Verification Script Overrides (used by scripts/verify/verify.mjs)
# R2_PUBLIC_BASE=https://pub-21518ce3034449a3a7b5a0b89551f710.r2.dev
# ARTICLE_DRAFTS_DIR=content/drafts
# HEADING_OVERLAP_MAX=0.6
