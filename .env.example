# Environment Variables for Mailbox Plus Website
# Copy this file to `.env` and fill in the values
# NEVER commit the actual `.env` file (it's in .gitignore)

# Cloudflare R2 Public Bucket URL (for images)
VITE_R2_PUBLIC_BASE_URL=https://pub-21518ce3034449a3a7b5a0b89551f710.r2.dev

# Resend API Key (for email delivery in sendEmail function)
RESEND_API_KEY=re_123456789_example

# Gemini AI API Key (for chatbot functionality and embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Places API Key (for live review fetching)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Netlify Auth Token (for Netlify Blobs / API access)
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here

# reCAPTCHA Keys (site key for frontend, secret key for serverless validation)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
VITE_RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Site URL (set automatically by Netlify context or manually for local dev)
SITE_URL=https://mailboxplusohio.com

# Stripe Secret Key (for create-checkout Netlify function)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

