---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Mailing Services in Concord Township, OH | Mailbox Plus | 5.0★"
  description="Full mailing services in Concord Township (44077): USPS stamps, package shipping, mailbox rentals, digital mail scanning, and document mailing. Open Mon-Fri 9-6, Sat 9-2. Call (440) 709-1946."
>
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Mailing Services",
      "description": "Full mailing services in Concord Township (44077): USPS stamps, package shipping, mailbox rentals, digital mail scanning, and document mailing.",
      "areaServed": {
        "@type": "Place",
        "name": "Concord Township, OH",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Concord Township",
          "addressRegion": "OH",
          "postalCode": "44077",
          "addressCountry": "US"
        }
      },
      "provider": {
        "@type": "LocalBusiness",
        "name": "Mailbox Plus",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "7554 Fredle Drive",
          "addressLocality": "Concord Township",
          "addressRegion": "OH",
          "postalCode": "44077"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "32"
        }
      },
      "offers": {
        "@type": "Offer",
        "name": "Standard Mailing",
        "priceCurrency": "USD",
        "priceRange": "Starting at $0.73"
      }
    }
  </script>

  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-center mb-8 text-[var(--color-primary)]">
      Mailing Services in Concord Township, OH
    </h1>

    <div class="grid gap-8 md:grid-cols-2">
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-[var(--color-primary-dark)]">
          Your Complete Mailing Service
        </h2>
        <ul class="list-disc list-inside space-y-3 text-[var(--color-text-secondary)]">
          <li>USPS postage stamps and Priority Mail shipping</li>
          <li>UPS, FedEx, and DHL package shipping</li>
          <li>Private mailbox rentals with real street address</li>
          <li>Digital mail scanning and forwarding</li>
          <li>Document printing and mailing</li>
          <li>Notary public on-site for mail-related documents</li>
          <li>Package acceptance from all carriers</li>
          <li>5.0-star rating from 32 verified Google reviews</li>
        </ul>
      </div>
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-[var(--color-primary-dark)]">
          Why Choose Mailbox Plus?
        </h2>
        <div class="space-y-4">
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">All-in-One Convenience</h3>
            <p class="text-[var(--color-text-secondary)]">No more driving to separate locations for stamps, shipping, and mailbox needs. We handle everything at one counter.</p>
          </div>
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Real Address, Not a PO Box</h3>
            <p class="text-[var(--color-text-secondary)]">Our private mailbox rentals give you a real street address at 7554 Fredle Drive — accepted by USPS, UPS, FedEx, and DHL for package delivery.</p>
          </div>
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Digital Mail Options</h3>
            <p class="text-[var(--color-text-secondary)]">Traveling or working remotely? We offer mail scanning and forwarding so you never miss important documents.</p>
          </div>
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Locally Owned & Operated</h3>
            <p class="text-[var(--color-text-secondary)]">Proudly serving Concord Township and all of Lake County. We know our customers by name.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t pt-8">
      <h2 class="text-2xl font-semibold text-[var(--color-primary-dark)] mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">Do you sell stamps?</h3>
          <p class="text-[var(--color-text-secondary)]">Yes! We carry USPS forever stamps and Priority Mail postage. No need to visit the post office just for stamps.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">Can I have my mail forwarded to another address?</h3>
          <p class="text-[var(--color-text-secondary)]">Absolutely. Mailbox Plus customers can request mail forwarding to any address. We offer both one-time forwarding and recurring options for seasonal residents and travelers.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">What's the difference between a PO Box and a private mailbox?</h3>
          <p class="text-[var(--color-text-secondary)]">A PO Box is a box at the post office that only accepts USPS mail. A private mailbox at Mailbox Plus accepts packages from ALL carriers — UPS, FedEx, USPS, and DHL — and gives you a real street address for business registration.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">Do you handle bulk or business mailings?</h3>
          <p class="text-[var(--color-text-secondary)]">Yes! We provide document printing, folding, stuffing, and mailing services for businesses. Ask about our Every Door Direct Mail (EDDM) program for local advertising.</p>
        </div>
      </div>
    </div>

    <div class="mt-16 text-center">
      <a href="tel:4407091946" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-semibold px-6 py-3 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        Call for Mailing Services: (440) 709-1946
      </a>
    </div>
  </div>
</BaseLayout>