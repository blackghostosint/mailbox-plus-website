---
import BaseLayout from '../layouts/BaseLayout.astro';
import OutboundLink from '../components/ui/OutboundLink.astro';
import { CANONICAL_R2_BASE_URL } from '../lib/media';
import { siteConfig, phoneFormatted, fullAddressSingleLine } from '../config/siteConfig';
import { getPageMeta } from '../config/pageMeta';
import { getWebPageSchema } from '../utils/schema';

const canonical = '/tailgate-giveaway/';
const instagramUrl = siteConfig.social?.instagram ?? 'https://www.instagram.com/mailboxplusohio';
const facebookUrl = siteConfig.social?.facebook ?? 'https://www.facebook.com/mailboxplusohio';
const instagramHandle = instagramUrl.replace('https://www.', '');
const pageMeta = getPageMeta(canonical)!;
const pageUrl = 'https://mailboxplusohio.com/tailgate-giveaway/';
const encodedPageUrl = encodeURIComponent(`${pageUrl}?utm_source=share&utm_medium=social&utm_campaign=tailgate-giveaway`);

const captionText =
  `I just entered to win a Cleveland Browns tailgate set — a 9x9 team canopy + 2 quad chairs ($360 value) — from Mailbox Plus in Concord Twp. Drawing is Nov 27 and the winner gets it before the Raiders game. Get your entries here:`;

const shareUrls = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedPageUrl}`,
  x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(captionText)}&url=${encodedPageUrl}`,
  nextdoor: `https://nextdoor.com/sharekit/?source=mailboxplus&body=${encodedPageUrl}%0A%0A${encodeURIComponent(captionText)}`,
};

const webPageSchema = getWebPageSchema(siteConfig, {
  name: pageMeta.title,
  description: pageMeta.description,
  url: canonical,
  datePublished: '2026-10-25',
  dateModified: '2026-10-25',
});
---

<BaseLayout canonical={canonical} ogImage="/og/tailgate-giveaway.png" schema={[webPageSchema]}>
  <!-- HERO -->
  <section class="relative bg-center py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)]"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-white text-base font-bold mb-6 border border-white/20">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent-gold)]"></span>
        November Giveaway · Drawing Fri, Nov 27
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight leading-[1.2] mb-6">
        Win a Cleveland Browns Tailgate Set
      </h1>
      <p class="text-xl sm:text-2xl text-white/85 leading-relaxed max-w-2xl mx-auto mb-4">
        A 9&times;9 Cleveland Browns canopy plus two quad team chairs — a
        <strong class="text-[var(--color-accent-gold)]">$359.97 value</strong> — free from your local shipping store.
      </p>
      <p class="text-lg text-white/70 max-w-2xl mx-auto">
        One entry every time you stop in. Winner drawn before the Browns host the Raiders on Nov 29 — so you can tailgate with it.
      </p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-b from-transparent to-[var(--color-bg-primary)]"></div>
  </section>

  <!-- THE PRIZE -->
  <section class="bg-[var(--color-bg-primary)] py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text-primary)] text-center mb-3">What's in the Set</h2>
      <p class="text-lg text-[var(--color-text-muted)] text-center mb-8 max-w-2xl mx-auto">Official licensed Cleveland Browns gear — a pop-up canopy and two tailgate chairs, ready for the next home game.</p>

      <div class="grid sm:grid-cols-2 gap-4 mb-8">
        <div class="bg-white rounded-2xl shadow-md border border-[var(--color-border)] overflow-hidden">
          <img src={`${CANONICAL_R2_BASE_URL}/giveaway/tailgate-canopy.webp`} alt="Cleveland Browns 9x9 pop-up canopy with team helmet logo and CLEVELAND BROWNS valance" class="w-full h-auto" loading="lazy" width="752" height="752" />
          <div class="px-5 py-4 border-t border-[var(--color-border)]">
            <p class="font-bold text-[var(--color-text-primary)]">Browns Economy Canopy</p>
            <p class="text-sm text-[var(--color-text-muted)]">Official 9&times;9 ft pop-up with carry bag, tie-downs &amp; stakes</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl shadow-md border border-[var(--color-border)] overflow-hidden">
          <img src={`${CANONICAL_R2_BASE_URL}/giveaway/tailgate-chair.webp`} alt="Cleveland Browns orange quad folding chair with helmet logo and mesh cup holder" class="w-full h-auto" loading="lazy" width="752" height="752" />
          <div class="px-5 py-4 border-t border-[var(--color-border)]">
            <p class="font-bold text-[var(--color-text-primary)]">Browns Quad Chairs &times;2</p>
            <p class="text-sm text-[var(--color-text-muted)]">Two official team folding chairs with cup holders</p>
          </div>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl p-6 shadow-md border border-[var(--color-border)] text-center">
          <p class="text-3xl font-bold text-[var(--color-text-primary)] mb-1">1</p>
          <p class="font-bold text-[var(--color-text-primary)] mb-1">Browns Economy Canopy</p>
          <p class="text-sm text-[var(--color-text-muted)]">Official 9&times;9 ft pop-up with carry bag, tie-downs &amp; stakes. 81 sq ft of shade. <span class="whitespace-nowrap">$279.99 value</span></p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-md border border-[var(--color-border)] text-center">
          <p class="text-3xl font-bold text-[var(--color-text-primary)] mb-1">2</p>
          <p class="font-bold text-[var(--color-text-primary)] mb-1">Browns Quad Chairs</p>
          <p class="text-sm text-[var(--color-text-muted)]">Two official team folding tailgate chairs, cup holders included. <span class="whitespace-nowrap">$79.98 value</span></p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-md border border-[var(--color-border)] text-center">
          <p class="text-3xl font-bold text-[var(--color-text-primary)] mb-1">0</p>
          <p class="font-bold text-[var(--color-text-primary)] mb-1">Dollars to Enter</p>
          <p class="text-sm text-[var(--color-text-muted)]">No purchase necessary. Stop in, get your ticket, you're in. <span class="whitespace-nowrap">$0.00</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO ENTER -->
  <section class="bg-white py-14 border-t border-[var(--color-border)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text-primary)] text-center mb-3">How to Enter</h2>
      <p class="text-lg text-[var(--color-text-muted)] text-center mb-8 max-w-2xl mx-auto">Physical raffle tickets at the counter — fill one out per entry, drop it in the bowl, keep your stub.</p>

      <div class="grid sm:grid-cols-3 gap-4 mb-8">
        <div class="rounded-2xl p-6 bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-center">
          <p class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-primary)] text-white text-2xl font-bold mb-3">1</p>
          <p class="text-2xl font-bold text-[var(--color-text-primary)] mb-1">1 Ticket</p>
          <p class="text-[var(--color-text-muted)]">Every visit to the store. Once a day, every day we're open in November.</p>
        </div>
        <div class="rounded-2xl p-6 bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-center">
          <p class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-primary)] text-white text-2xl font-bold mb-3">3</p>
          <p class="text-2xl font-bold text-[var(--color-text-primary)] mb-1">3 Tickets</p>
          <p class="text-[var(--color-text-muted)]">Any purchase over $10 — shipping a package, a packing job, printing services — anything on your receipt over $10.</p>
        </div>
        <div class="rounded-2xl p-6 bg-[var(--color-accent-gold)]/10 border-2 border-[var(--color-accent-gold)]/40 text-center">
          <p class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-accent-gold)] text-[var(--color-text-primary)] text-2xl font-bold mb-3">10</p>
          <p class="text-2xl font-bold text-[var(--color-text-primary)] mb-1">10 Tickets</p>
          <p class="text-[var(--color-text-muted)]">A new mailbox rental. The biggest prize we've got for our best customers. New rentals only.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-lg border border-[var(--color-border)] text-center">
        <p class="text-xl font-bold text-[var(--color-text-primary)] mb-2">Bring a friend. Share this page.</p>
        <p class="text-[var(--color-text-muted)] mb-4">Every share is a warm intro — send it to your tailgate crew before the drawing.</p>
        <div class="flex flex-wrap justify-center gap-2.5 mb-4">
          <OutboundLink href={shareUrls.facebook} data-share-method="facebook"
            class="share-btn group flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-facebook text-white rounded-xl font-medium text-sm shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
            <svg aria-hidden="true" focusable="false" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Share on Facebook</span>
          </OutboundLink>
          <OutboundLink href={shareUrls.x} data-share-method="x"
            class="share-btn group flex items-center justify-center gap-2 px-4 py-2.5 bg-black text-white rounded-xl font-medium text-sm shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
            <svg aria-hidden="true" focusable="false" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>Share on X</span>
          </OutboundLink>
          <OutboundLink href={shareUrls.nextdoor} data-share-method="nextdoor"
            class="share-btn group flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-nextdoor text-white rounded-xl font-medium text-sm shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
            <svg aria-hidden="true" focusable="false" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M4.6 10.6L12 2.7l7.4 7.9-1.8 1.9L12 6.6 6.4 12.5 4.6 10.6zM5.5 12.7v8.6H18v-8.6l-6-6.4-6.5 6.4z"/></svg>
            <span>Share on Nextdoor</span>
          </OutboundLink>
          <button type="button" data-copy={captionText}
            class="copy-caption-btn group flex items-center justify-center gap-2 px-4 py-2.5 bg-instagram-gradient text-white rounded-xl font-medium text-sm shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
            <svg aria-hidden="true" focusable="false" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            <span>Copy caption</span>
          </button>
          <button type="button" class="copy-link-btn inline-flex items-center gap-2 px-4 py-2.5 border-2 border-[var(--color-primary)] text-[var(--color-primary)] rounded-xl font-medium text-sm hover:bg-[var(--color-primary)] hover:text-white hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
            <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            <span>Copy link</span>
          </button>
        </div>
        <p class="text-sm text-[var(--color-text-muted)]">
          Following us pays too: show the counter you follow
          <OutboundLink href={instagramUrl} class="text-[var(--color-primary)] font-semibold underline">our Instagram</OutboundLink> or
          <OutboundLink href={facebookUrl} class="text-[var(--color-primary)] font-semibold underline">Facebook page</OutboundLink>
          and get <strong>2 bonus tickets</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- KEY DATES -->
  <section class="bg-[var(--color-bg-primary)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text-primary)] text-center mb-8">Key Dates</h2>
      <div class="space-y-4">
        <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-md border border-[var(--color-border)]">
          <div class="shrink-0 w-14 text-center">
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">Nov</p>
            <p class="text-2xl font-bold text-[var(--color-primary)]">1</p>
          </div>
          <p class="text-[var(--color-text-primary)] pt-1"><strong>Entries open.</strong> Ticket bowl is on the counter — grab one every visit.</p>
        </div>
        <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-md border border-[var(--color-border)]">
          <div class="shrink-0 w-14 text-center">
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">Nov</p>
            <p class="text-2xl font-bold text-[var(--color-primary)]">26</p>
          </div>
          <p class="text-[var(--color-text-primary)] pt-1"><strong>Last day to enter.</strong> Ticket bowl closes at close of business.</p>
        </div>
        <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-md border border-[var(--color-border)]">
          <div class="shrink-0 w-14 text-center">
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">Nov</p>
            <p class="text-2xl font-bold text-[var(--color-accent-gold)]">27</p>
          </div>
          <p class="text-[var(--color-text-primary)] pt-1"><strong>Drawing day.</strong> One winning ticket pulled live on our <OutboundLink href={instagramUrl} class="text-[var(--color-primary)] font-semibold underline">Instagram</OutboundLink> — winner picks up the full set before the Browns host the Raiders Nov 29.</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center mt-10">
        <p class="text-xl font-bold text-[var(--color-text-primary)] mb-4">The bowl is on the counter. Come fill it with your name.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/contact-us/" class="inline-flex items-center px-6 py-3 bg-[var(--color-primary)] text-white rounded-xl font-semibold shadow-sm hover:bg-[var(--color-primary-dark)] hover:shadow-md transition-all duration-200">
            Get Directions &amp; Hours
          </a>
          <a href="/private-mailbox-rental/" class="inline-flex items-center px-6 py-3 border-2 border-[var(--color-primary)] text-[var(--color-primary)] rounded-xl font-semibold hover:bg-[var(--color-primary)] hover:text-white transition-all duration-200">
            Learn About Mailbox Rentals
          </a>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] mt-4">Questions? Call us at <a href={`tel:+1${phoneFormatted.replace(/\D/g, '')}`} class="font-semibold text-[var(--color-primary)]">{phoneFormatted}</a></p>
      </div>
    </div>
  </section>

  <!-- OFFICIAL RULES -->
  <section class="bg-white py-12 border-t border-[var(--color-border)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-xl font-bold text-[var(--color-text-primary)] mb-4">Official Rules</h2>
      <div class="text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3">
        <p><strong class="text-[var(--color-text-primary)]">NO PURCHASE NECESSARY TO ENTER OR WIN.</strong> A purchase will not increase your chances of winning. Open to legal residents of Ohio, 18 years or older. Void where prohibited.</p>
        <p><strong class="text-[var(--color-text-primary)]">How to enter:</strong> (1) Visit Mailbox Plus, {fullAddressSingleLine}, during business hours between Nov 1–26, 2026 and complete a raffle ticket (limit one visit entry per person per day). (2) Receive three (3) entries with any purchase over $10. (3) Receive ten (10) entries with a new mailbox rental agreement. (4) Bonus: two (2) entries for following our Instagram or Facebook page (show a staff member at the counter). (5) Free alternate means of entry: mail a 3&times;5 card with your name, phone number, and "Tailgate Giveaway" to Mailbox Plus, 7554 Fredle Dr, Concord Twp OH 44077 (postmarked by Nov 26, 2026; one card per envelope; mail-in entries receive two (2) entries).</p>
        <p><strong class="text-[var(--color-text-primary)]">Prize:</strong> one (1) prize package consisting of one Cleveland Browns Economy Canopy (9&times;9 ft) and two Cleveland Browns Quad Chairs, approximate retail value $359.97. Prize is non-transferable and has no cash value. Product images shown are representative; actual items are on display at the store.</p>
        <p><strong class="text-[var(--color-text-primary)]">Drawing:</strong> winner will be selected in a random drawing from all eligible entries on or about Nov 27, 2026. Odds of winning depend on the number of eligible entries received. Winner need not be present to win and will be announced on our Instagram page ({instagramHandle}) and contacted by phone using the information on the winning ticket. If the winner cannot be reached within 7 days, an alternate winner will be drawn.</p>
        <p><strong class="text-[var(--color-text-primary)]">Sponsor:</strong> Mailbox Plus, 7554 Fredle Dr, Concord Twp, OH 44077. This promotion is in no way sponsored, endorsed, or administered by, or associated with, the NFL, the Cleveland Browns, Logo Brands, Meta, or X Corp. Product names and team marks are the property of their respective owners. Photo credits: product imagery courtesy of Logo Brands (logobrands.com).</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initTailgateGiveaway() {
    trackEvent('page_view_giveaway', { page_title: 'Tailgate Giveaway' });

    document.querySelectorAll('.share-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        trackEvent('share', {
          method: btn.getAttribute('data-share-method') || 'unknown',
          content_type: 'giveaway',
          item_id: 'tailgate-giveaway',
        });
      });
    });

    document.querySelectorAll('.copy-link-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        trackEvent('share', {
          method: 'copy_link',
          content_type: 'giveaway',
          item_id: 'tailgate-giveaway',
        });
        copyToClipboard(window.location.href);
      });
    });

    document.querySelectorAll('.copy-caption-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        trackEvent('share', {
          method: 'copy_caption',
          content_type: 'giveaway',
          item_id: 'tailgate-giveaway',
        });
        const text = btn.getAttribute('data-copy') || '';
        if (text) copyToClipboard(text);
      });
    });
  }

  import { onDOMReady } from '../lib/dom-utils';
  import { trackEvent } from '../lib/analytics';
  import { copyToClipboard } from '../lib/clipboard';

  onDOMReady(initTailgateGiveaway);
</script>
