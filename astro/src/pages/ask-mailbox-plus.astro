---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Ask Mailbox Plus | Your Questions Answered" description="Have a question about shipping, printing, or mailbox rentals? Ask Mailbox Plus — we have answers." noindex>
  <section class="bg-gradient-to-br from-[var(--color-gradient-start)] via-[var(--color-gradient-mid)] to-[var(--color-gradient-end)] text-white py-16 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Ask Mailbox Plus</h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto">
        Common questions, straight answers.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="space-y-6">
      <p class="text-[var(--color-text-secondary)] mb-8">Have a question not listed here? <a href="/contact-us" class="text-[var(--color-primary)] hover:underline font-semibold">Contact us</a> and we'll get back to you.</p>

      <details class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 shadow-sm open:bg-[var(--color-bg-secondary)] group">
        <summary class="px-6 py-4 text-left text-[var(--color-accent-warm)] font-semibold cursor-pointer list-none flex items-center justify-between [&::-webkit-details-marker]:hidden">
          <span>What carriers do you ship with?</span>
          <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="px-6 pb-4 text-sm text-[var(--color-text-secondary)] leading-relaxed">We ship via FedEx, UPS, USPS, and DHL. You can drop off pre-labeled packages or we can help you create a shipment with any of these carriers.</div>
      </details>

      <details class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 shadow-sm open:bg-[var(--color-bg-secondary)] group">
        <summary class="px-6 py-4 text-left text-[var(--color-accent-warm)] font-semibold cursor-pointer list-none flex items-center justify-between [&::-webkit-details-marker]:hidden">
          <span>Do you offer packing services?</span>
          <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="px-6 pb-4 text-sm text-[var(--color-text-secondary)] leading-relaxed">Yes! We professionally pack items of all shapes and sizes — from fragile electronics to odd-shaped gifts. We also sell boxes, bubble wrap, packing tape, and other supplies.</div>
      </details>

      <details class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 shadow-sm open:bg-[var(--color-bg-secondary)] group">
        <summary class="px-6 py-4 text-left text-[var(--color-accent-warm)] font-semibold cursor-pointer list-none flex items-center justify-between [&::-webkit-details-marker]:hidden">
          <span>How do mailbox rentals work?</span>
          <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="px-6 pb-4 text-sm text-[var(--color-text-secondary)] leading-relaxed">Rent a private mailbox and get a real street address, secure package acceptance, mail forwarding, and 24/7 access. USPS-compliant with valid ID verification. Month-to-month terms available.</div>
      </details>

      <details class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 shadow-sm open:bg-[var(--color-bg-secondary)] group">
        <summary class="px-6 py-4 text-left text-[var(--color-accent-warm)] font-semibold cursor-pointer list-none flex items-center justify-between [&::-webkit-details-marker]:hidden">
          <span>Can I print documents or make copies?</span>
          <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="px-6 pb-4 text-sm text-[var(--color-text-secondary)] leading-relaxed">Yes — we offer black & white and color printing, copying, scanning, faxing, and graphic design services. Business cards, flyers, posters, and more.</div>
      </details>

      <details class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 shadow-sm open:bg-[var(--color-bg-secondary)] group">
        <summary class="px-6 py-4 text-left text-[var(--color-accent-warm)] font-semibold cursor-pointer list-none flex items-center justify-between [&::-webkit-details-marker]:hidden">
          <span>Do you offer notary services?</span>
          <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="px-6 pb-4 text-sm text-[var(--color-text-secondary)] leading-relaxed">Yes, we have a notary public on staff. Bring valid photo ID and unsigned documents. Walk-ins welcome.</div>
      </details>
    </div>
  </section>
</BaseLayout>
