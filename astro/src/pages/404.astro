---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Mailbox Plus" description="The page you're looking for doesn't exist." noindex>
  <section class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
      <h1 class="text-6xl font-bold text-[var(--color-primary)] mb-4">404</h1>
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)] mb-4">Page Not Found</h2>
      <p class="text-[var(--color-text-secondary)] mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-semibold px-8 py-3 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
