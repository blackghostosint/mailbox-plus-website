---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout 
  title="Page Not Found | Mailbox Plus" 
  description="The page you're looking for doesn't exist. Return to the homepage." 
  noindex={true}
>
  <div class="max-w-2xl mx-auto py-20 px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="mb-6 text-4xl font-bold text-[var(--color-primary)]">404</h1>
    <p class="mb-4 text-2xl text-[var(--color-text-primary)]">Page Not Found</p>
    <p class="mb-8 text-[var(--color-text-secondary)] max-w-xl mx-auto">
      The page you're looking for doesn't exist or has been moved. Please check the URL or return to the homepage.
    </p>
    <a href="/" class="inline-block px-6 py-3 bg-[var(--color-primary)] text-white font-medium rounded-lg hover:bg-[var(--color-accent-gold)] transition-colors">
      Return to Homepage
    </a>
  </div>
</BaseLayout>