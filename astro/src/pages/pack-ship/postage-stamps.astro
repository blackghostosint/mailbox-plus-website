---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { getServiceById } from '../../utils/services-helpers';

const service = getServiceById('postage-stamps')!;
---

<ServiceLayout service={service}>
  <div slot="intro" class="max-w-3xl mx-auto">
    <div class="relative rounded-[28px] bg-[var(--color-bg-secondary)]/80 backdrop-blur-xl border border-[var(--color-border)] shadow-md px-6 py-6 md:px-10 md:py-8">
      <p class="text-[var(--color-text-primary)] leading-relaxed">
        Skip the long lines. Mailbox Plus is your USPS drop-off alternative for stamps, mailing supplies, and package shipping. While you're here, check out our <a href="/home-business/mailbox-rental/" class="text-[var(--color-accent-warm)] hover:underline font-medium">private mailbox rentals</a> or ask about <a href="/pack-ship/usps-services/" class="text-[var(--color-accent-warm)] hover:underline font-medium">certified mail services</a>.
      </p>
    </div>
  </div>
</ServiceLayout>
