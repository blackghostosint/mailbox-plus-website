---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | Mailbox Plus" description="About Mailbox Plus." noindex>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-text-primary)] mb-6">About Mailbox Plus</h1>
    <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">Locally owned and operated in Concord Township, Ohio. Serving Lake County with shipping, printing, mailbox rentals, and business services.</p>
    <a href="/" class="inline-flex items-center gap-2 mt-8 bg-[var(--color-primary)] text-white font-semibold px-6 py-2.5 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">Back to Home</a>
  </section>
</BaseLayout>
