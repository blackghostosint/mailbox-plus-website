---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleLoader } from '../../utils/articleLoader';
import { marked } from 'marked';
import { getArticleSchema, getWebPageSchema } from '../../utils/schema';
import { siteConfig } from '../../config/siteConfig';
import { normalizePathname, toCanonicalUrl } from '../../utils/canonical-url';

const R2_BASE = 'https://pub-21518ce3034449a3a7b5a0b89551f710.r2.dev';

export async function getStaticPaths() {
  const allArticles = await articleLoader.getAllArticles();
  return allArticles
    .filter((a) => a.frontmatter.status !== 'draft')
    .map((article) => ({
      params: { slug: article.frontmatter.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const { frontmatter, content } = article;
const { title, description, pubDate, author, category, image, imageAlt, relatedServices, lastModified, keywords, slug } = frontmatter;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const articleUrl = toCanonicalUrl(`/articles/${slug}`);
const ogImage = image.startsWith('http') ? image : `${R2_BASE}/${image.replace(/^\/?images\//, '')}`;

// Configure marked to rewrite relative image paths to R2 URLs
const renderer = new marked.Renderer();
renderer.image = ({ href, title: imgTitle, text }) => {
  let src = href || '';
  if (src && !src.startsWith('http://') && !src.startsWith('https://')) {
    src = `${R2_BASE}/${src.replace(/^\/?images\//, '')}`;
  }
  const altText = text || imgTitle || '';
  return `<div class="my-8 rounded-xl overflow-hidden shadow-lg border border-[var(--color-bg-secondary)]">
    <img src="${src}" alt="${altText}" class="w-full h-auto object-cover" loading="lazy" />
    ${altText ? `<p class="text-sm text-center text-[var(--color-text-secondary)] mt-2 italic">${altText}</p>` : ''}
  </div>`;
};
renderer.link = ({ href, text }) => {
  const isInternal = href?.startsWith('/');
  const cls = 'text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] underline decoration-[var(--color-border-blue)] underline-offset-2';
  if (isInternal) {
    return `<a href="${href}" class="${cls}">${text}</a>`;
  }
  return `<a href="${href}" target="_blank" rel="noopener noreferrer" class="${cls}">${text}</a>`;
};

const renderedContent = marked.parse(content, { renderer });

const articleSchema = getArticleSchema(siteConfig, {
  headline: title,
  description,
  image: ogImage,
  datePublished: pubDate,
  dateModified: lastModified ?? pubDate,
  authorName: author,
  articleSection: category,
  keywords: keywords ?? [],
  url: articleUrl,
});
const webPageSchema = getWebPageSchema(siteConfig, {
  name: title,
  description,
  url: articleUrl,
  breadcrumbItems: [
    { name: 'Home', url: toCanonicalUrl('/') },
    { name: 'Articles', url: toCanonicalUrl('/articles') },
    { name: title, url: articleUrl },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/articles/${slug}`}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={pubDate} />
    {lastModified && <meta property="article:modified_time" content={lastModified} />}
    {author && <meta property="article:author" content={author} />}
    {keywords?.length && <meta name="keywords" content={keywords.join(', ')} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  </Fragment>

  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)] py-16 lg:py-24 text-center">
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/15 text-white text-sm font-medium mb-6 backdrop-blur-sm border border-white/25">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 013 12V7a4 4 0 014-4z" />
        </svg>
        <span class="uppercase tracking-wider">{category.replace(/-/g, ' ')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight mb-6">
        {title}
      </h1>

      <p class="text-xl md:text-2xl text-white/80 leading-relaxed font-medium max-w-3xl mx-auto mb-10">
        {description}
      </p>

      <div class="flex items-center justify-center gap-6 text-sm text-white/70">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={pubDate}>{formattedDate}</time>
        </div>
        {author && (
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>By {author}</span>
          </div>
        )}
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-[var(--color-bg-primary)] z-10"></div>
  </section>

  {/* Content Section */}
  <div class="bg-[var(--color-bg-primary)] py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Featured image */}
      {image && (
        <div class="mb-12 rounded-xl overflow-hidden shadow-xl -mt-32 relative z-20">
          <img
            src={ogImage}
            alt={imageAlt || title}
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      )}

      <div class="prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[var(--color-primary-dark)] prose-a:text-[var(--color-primary)] prose-img:rounded-xl prose-img:shadow-lg">
        <div set:html={renderedContent} />
      </div>

      {/* Related Services */}
      {relatedServices && relatedServices.length > 0 && (
        <div class="mt-16 pt-10" style="border-top: 1px solid var(--color-border)">
          <h3 class="text-2xl font-bold mb-6" style="color: var(--color-text-primary)">
            Related Services
          </h3>
          <div class="grid gap-4 md:grid-cols-2">
            {relatedServices.map((servicePath: string) => {
              const label = servicePath.split('/').pop()?.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) || 'View Service';
              return (
                <a href={normalizePathname(servicePath)} class="group p-6 rounded-xl transition-all duration-300 cursor-pointer bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--color-border-strong)] hover:bg-[var(--color-accent-warm)]/10">
                  <div class="flex justify-between items-center">
                    <span class="font-semibold group-hover:text-[var(--color-accent-warm)]" style="color: var(--color-text-primary)">
                      {label}
                    </span>
                    <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" style="color: var(--color-text-muted)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      {/* Bottom CTA - Navy Gradient */}
      <div class="mt-20 p-8 bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)] rounded-2xl shadow-xl text-center text-white">
        <h3 class="text-2xl font-bold mb-4">Have Questions?</h3>
        <p class="text-white/80 mb-8 max-w-xl mx-auto">
          Stop by our location in Concord Township or give us a call. We're here to help with all your shipping and printing needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact-us/" class="px-6 py-3 rounded-lg bg-[var(--color-accent-warm)] text-[var(--color-primary-dark)] font-semibold border-none hover:bg-[var(--color-accent-warm-light)] transition-colors">
            Contact Us
          </a>
          <a href="/services/" class="px-6 py-3 rounded-lg border-2 border-[var(--color-accent-warm)] text-[var(--color-accent-warm)] font-semibold hover:bg-[var(--color-accent-warm)] hover:text-[var(--color-primary-dark)] transition-colors">
            View All Services
          </a>
        </div>
      </div>

      {/* Back to Articles */}
      <div class="mt-12 pt-8" style="border-top: 1px solid var(--color-border)">
        <a href="/articles/" class="text-[var(--color-accent-warm)] hover:underline font-semibold">&larr; Back to Articles</a>
      </div>
    </div>
  </div>
</BaseLayout>
