---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleLoader } from '../../utils/articleLoader';

const allArticles = await articleLoader.getAllArticles();
const published = allArticles.filter(a => a.frontmatter.status !== 'draft');
const categories = [...new Set(published.map(a => a.frontmatter.category))];
---

<BaseLayout
  title="Articles & Guides | Mailbox Plus"
  description="Read articles and guides about shipping, printing, mailbox rentals, and business services from Mailbox Plus in Concord Township, Ohio."
>
  <section class="bg-gradient-to-br from-[var(--color-gradient-start)] via-[var(--color-gradient-mid)] to-[var(--color-gradient-end)] text-white py-16 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Articles & Guides</h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto">Tips, guides, and insights for shipping, printing, and business services.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {categories.map(cat => (
      <div key={cat} class="mb-16">
        <h2 class="text-2xl font-bold text-[var(--color-text-primary)] mb-6 capitalize">{cat.replace(/-/g, ' ')}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {published.filter(a => a.frontmatter.category === cat).map(article => (
            <a href={`/articles/${article.frontmatter.slug}`} class="block p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)]/80 hover:shadow-lg hover:-translate-y-1 transition-all shadow-sm">
              <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">{article.frontmatter.title}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{article.frontmatter.description}</p>
              <p class="text-xs text-[var(--color-text-muted)] mt-3">{new Date(article.frontmatter.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
