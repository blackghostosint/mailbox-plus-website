---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home & Business Services | Mailbox Plus — Concord Township, OH"
  description="Mailbox rentals, virtual mailbox, shredding, document scanning, fax, and notary services in Concord Township, Ohio."
>
  <section class="bg-gradient-to-br from-[var(--color-gradient-start)] via-[var(--color-gradient-mid)] to-[var(--color-gradient-end)] text-white py-16 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Home & Business Services</h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto">
        Mailbox rentals, shredding, scanning, fax, and more.
      </p>
    </div>
  </section>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
    <a href="/home-business/mailbox-rental/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">Mailbox Rentals</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">Private mailbox with real street address.</p></a>
    <a href="/home-business/digital-mailbox-rental/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">Digital Mailbox</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">View your mail online from anywhere.</p></a>
    <a href="/home-business/shredding/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">Shredding</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">Secure document destruction.</p></a>
    <a href="/home-business/document-scanning/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">Document Scanning</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">Digitize your important documents.</p></a>
    <a href="/home-business/fax-services/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">Fax Services</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">Send and receive faxes.</p></a>
    <a href="/home-business/notary-services/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">Notary Services</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">Notary public on staff.</p></a>
    <a href="/home-business/every-door-direct-mail/" class="block p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent-warm)] shadow-sm transition-all"><h3 class="font-semibold">EDDM</h3><p class="text-sm text-[var(--color-text-secondary)] mt-1">Every Door Direct Mail.</p></a>
  </section>
</BaseLayout>
