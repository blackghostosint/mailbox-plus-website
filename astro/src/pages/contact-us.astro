---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';
const { contact } = siteConfig;
const phoneDigits = contact.phone.replace(/[^0-9]/g, '');
const hours = [
  { day: 'Monday - Friday', time: '9:00 AM - 6:00 PM' },
  { day: 'Saturday', time: '9:00 AM - 2:00 PM' },
  { day: 'Sunday', time: 'Closed' },
];
---

<BaseLayout
  title="Contact Us - Mailbox Plus"
  description="Get in touch with Mailbox Plus in Concord Township, Ohio. Call, email, or visit us for all your shipping and printing needs."
  canonical="/contact-us"
  ogImage="/og/contact-us.png"
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)] py-16 lg:py-24 text-center">
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight mb-6">Get in Touch</h1>
      <p class="text-xl md:text-2xl text-white/80 leading-relaxed font-medium max-w-3xl mx-auto mb-10">Visit our store in Concord Twp., or contact us today. We're here to help with all your shipping, printing, and business service needs.</p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-[var(--color-bg-primary)] z-10" />
  </section>

  <!-- CONTENT -->
  <div class="relative z-20 -mt-20 container mx-auto px-4 pb-20 space-y-20">
    <!-- Contact Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Phone -->
      <div class="group relative flex flex-col items-center p-8 text-center rounded-lg bg-[var(--color-bg-secondary)]/80 backdrop-blur-xl border border-[var(--color-border)] shadow-md hover:shadow-lg transition-all duration-300">
        <div class="w-16 h-16 bg-[var(--color-accent-warm)]/10 rounded-2xl flex items-center justify-center mb-6 text-[var(--color-accent-warm)] shadow-inner">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2">Phone</h3>
        <p class="text-[var(--color-text-secondary)] mb-6 leading-relaxed flex-grow">{contact.phone}</p>
        <a href={`tel:${phoneDigits}`} class="text-[var(--color-accent-warm)] font-bold text-base hover:text-[var(--color-accent-warm-light)] transition-colors">Call Now →</a>
      </div>
      <!-- Email -->
      <div class="group relative flex flex-col items-center p-8 text-center rounded-lg bg-[var(--color-bg-secondary)]/80 backdrop-blur-xl border border-[var(--color-border)] shadow-md hover:shadow-lg transition-all duration-300">
        <div class="w-16 h-16 bg-[var(--color-accent-warm)]/10 rounded-2xl flex items-center justify-center mb-6 text-[var(--color-accent-warm)] shadow-inner">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2">Email</h3>
        <p class="text-[var(--color-text-secondary)] mb-6 leading-relaxed flex-grow">{contact.email}</p>
        <a href={`mailto:${contact.email}`} class="text-[var(--color-accent-warm)] font-bold text-base hover:text-[var(--color-accent-warm-light)] transition-colors">Send Email →</a>
      </div>
      <!-- Address -->
      <div class="group relative flex flex-col items-center p-8 text-center rounded-lg bg-[var(--color-bg-secondary)]/80 backdrop-blur-xl border border-[var(--color-border)] shadow-md hover:shadow-lg transition-all duration-300">
        <div class="w-16 h-16 bg-[var(--color-accent-warm)]/10 rounded-2xl flex items-center justify-center mb-6 text-[var(--color-accent-warm)] shadow-inner">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2">Address</h3>
        <p class="text-[var(--color-text-secondary)] mb-6 leading-relaxed flex-grow">{contact.address.street}, {contact.address.city}, {contact.address.state} {contact.address.zip}</p>
        <a href="https://www.google.com/maps/dir/?api=1&destination=41.66497,-81.24164" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-warm)] font-bold text-base hover:text-[var(--color-accent-warm-light)] transition-colors">Get Directions →</a>
      </div>
    </div>

    <!-- Form + Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">
      <!-- Form -->
      <section>
        <div class="relative rounded-[28px] px-6 md:px-10 py-8 md:py-10 bg-[var(--color-bg-secondary)]/80 backdrop-blur-xl border border-[var(--color-border)] shadow-md h-full">
          <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text-primary)] mb-4">Send Us a Message</h2>
          <p class="text-[var(--color-text-secondary)] mb-8 leading-relaxed">Have a question about our services or need a custom quote? Fill out the form below and we'll get back to you promptly.</p>
          <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
            <input type="hidden" name="form-name" value="contact" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="text-sm font-semibold text-[var(--color-text-primary)]">Full Name *</label>
                <input type="text" id="name" name="name" required aria-label="Full name" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="Enter your name" />
              </div>
              <div class="space-y-2">
                <label for="email" class="text-sm font-semibold text-[var(--color-text-primary)]">Email Address *</label>
                <input type="email" id="email" name="email" required aria-label="Email address" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="Enter your email" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="phone" class="text-sm font-semibold text-[var(--color-text-primary)]">Phone Number</label>
                <input type="tel" id="phone" name="phone" aria-label="Phone number" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="(440) 555-0123" />
              </div>
              <div class="space-y-2">
                <label for="service" class="text-sm font-semibold text-[var(--color-text-primary)]">Service Interest</label>
                <select id="service" name="service" aria-label="Service interest" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm appearance-none">
                  <option value="">Select a service</option>
                  <option value="shipping">Pack & Ship</option>
                  <option value="printing">Printing Services</option>
                  <option value="mailbox">Mailbox Rental</option>
                  <option value="fingerprinting">Digital Fingerprinting</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="space-y-2">
              <label for="message" class="text-sm font-semibold text-[var(--color-text-primary)]">Message *</label>
              <textarea id="message" name="message" required rows="5" aria-label="Your message" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm resize-none" placeholder="How can we help you?"></textarea>
            </div>
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-[var(--color-primary)] text-white font-semibold text-base px-8 py-3.5 rounded-md hover:bg-[var(--color-primary-dark)] transition-all shadow-md">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 2L11 13"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 2L15 22l-4-9-9-4 20-7z"/></svg>
              Send Message
            </button>
          </form>
        </div>
      </section>

      <!-- Sidebar -->
      <div class="space-y-8">
        <!-- Hours -->
        <div class="rounded-[28px] p-8 bg-[var(--color-bg-secondary)]/80 backdrop-blur border border-[var(--color-border)] shadow-md">
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 rounded-full bg-[var(--color-accent-warm)]/10 flex items-center justify-center mr-4 text-[var(--color-accent-warm)]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--color-text-primary)]">Store Hours</h3>
          </div>
          <div class="space-y-4">
            {hours.map((s) => (
              <div class="flex justify-between items-center border-b border-[var(--color-border)] pb-2 last:border-0 last:pb-0">
                <span class="text-[var(--color-text-secondary)] font-medium">{s.day}</span>
                <span class="text-[var(--color-text-primary)] font-bold">{s.time}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Map -->
        <div class="bg-[var(--color-bg-secondary)] rounded-[28px] overflow-hidden h-96 w-full shadow-md border border-[var(--color-border)]">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2987.5!2d-81.24164!3d41.66497!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDHCsDM5JzUzLjkiTiA4McKwMTQnMzAuMCJX!5e0!3m2!1sen!2sus" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mailbox Plus Location"></iframe>
        </div>

        <!-- Google Reviews -->
        <div class="bg-[var(--color-bg-secondary)]/70 border border-[var(--color-border)] rounded-2xl p-6 shadow-md flex flex-col items-center text-center space-y-4">
          <div class="flex items-center gap-2">
            <div class="text-[var(--color-accent-gold)] text-2xl font-bold">★★★★★</div>
            <span class="text-lg font-bold text-[var(--color-text-primary)]">{siteConfig.aggregateRating?.ratingValue || 5.0} / 5</span>
          </div>
          <div>
            <p class="text-base font-bold text-[var(--color-text-primary)]">Based on {siteConfig.aggregateRating?.reviewCount || 32} Google Reviews</p>
            <p class="text-sm text-[var(--color-text-secondary)] mt-1">100% of our customers rate us 5 stars for retail packing & shipping!</p>
          </div>
          <a href="https://g.page/r/CYyNUX4atT3PEBM/review" target="_blank" rel="noopener noreferrer" class="w-full inline-block bg-[var(--color-accent-warm)] text-white text-sm font-bold py-3 px-6 rounded-xl hover:bg-[var(--color-accent-warm-light)] active:scale-95 transition-all shadow-sm">Write a Google Review</a>
        </div>

        <!-- Directions Tip -->
        <div class="bg-[var(--color-bg-secondary)]/70 border border-[var(--color-border)] rounded-2xl p-6 text-center">
          <p class="text-sm text-[var(--color-text-secondary)] font-medium">📍 We are located in the Gristmill Village plaza, next to Pub Frato and close to I-90.</p>
        </div>
      </div>
    </div>

    <!-- Our Services -->
    <section>
      <div class="relative rounded-[28px] px-6 md:px-10 py-8 md:py-10 shadow-md bg-[var(--color-bg-secondary)]/80 backdrop-blur-xl border border-[var(--color-border)] text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text-primary)] mb-6">Our Services</h2>
        <p class="text-[var(--color-text-secondary)] mb-8 max-w-2xl mx-auto">While you're here, explore what we can do for you:</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/pack-ship/" class="px-6 py-3 rounded-xl bg-[var(--color-accent-warm)] text-white font-semibold hover:bg-[var(--color-accent-warm-light)] transition-all">📦 Pack & Ship</a>
          <a href="/copy-print/" class="px-6 py-3 rounded-xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-[var(--color-text-primary)] font-semibold hover:bg-[var(--color-accent-warm)]/10 transition-all">🖨️ Copy & Print</a>
          <a href="/home-business/mailbox-rental/" class="px-6 py-3 rounded-xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-[var(--color-text-primary)] font-semibold hover:bg-[var(--color-accent-warm)]/10 transition-all">✉️ Mailbox Rental</a>
          <a href="/home-business/notary-services/" class="px-6 py-3 rounded-xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-[var(--color-text-primary)] font-semibold hover:bg-[var(--color-accent-warm)]/10 transition-all">📋 Notary Services</a>
          <a href="/pack-ship/package-drop-offs/" class="px-6 py-3 rounded-xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-[var(--color-text-primary)] font-semibold hover:bg-[var(--color-accent-warm)]/10 transition-all">📬 Drop Off a Package</a>
          <a href="/tracking/" class="px-6 py-3 rounded-xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-[var(--color-text-primary)] font-semibold hover:bg-[var(--color-accent-warm)]/10 transition-all">🔍 Track a Shipment</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
