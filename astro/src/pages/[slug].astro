---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { services } from '../config/services';
import type { Service } from '../types/services';

export async function getStaticPaths() {
  // Derive excluded slugs dynamically from existing static page files and top-level subdirectories in astro/src/pages/
  const staticPageFiles = import.meta.glob(['./*.astro', './*/index.astro', './*.ts', './*.js']);
  const EXCLUDED_SLUGS = new Set(
    Object.keys(staticPageFiles)
      .map((file) => file.replace(/^\.\//, '').replace(/\.astro$/, '').replace(/\/index$/, '').replace(/\.(ts|js)$/, ''))
      .filter((slug) => slug !== '[slug]' && slug !== '')
  );

  const seenSlugs = new Set<string>();
  const paths = [];

  for (const service of services) {
    if (!service.slug) continue;
    const cleanSlug = service.slug.replace(/^\//, '').replace(/\/$/, '');

    // Only route root-level slugs (no subdirectories) that are not static pages
    if (cleanSlug.includes('/')) continue;
    if (EXCLUDED_SLUGS.has(cleanSlug)) continue;
    if (seenSlugs.has(cleanSlug)) continue;

    seenSlugs.add(cleanSlug);
    paths.push({
      params: { slug: cleanSlug },
      props: { service },
    });
  }

  return paths;
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<ServiceLayout service={service} ogImage={service.ogImage} />
