---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { services } from '../config/services';
import type { Service } from '../types/services';

export async function getStaticPaths() {
  // Slugs that are handled by explicit static files in astro/src/pages/
  const EXCLUDED_SLUGS = new Set([
    'about-us',
    'accessibility',
    'after-signup',
    'amazon-counter',
    'ask-mailbox-plus',
    'contact-us',
    'copy-print',
    'guide',
    'home-business',
    'index',
    'mailbox-rental-concord-ohio',
    'pack-ship',
    'pickup-hours',
    'privacy',
    'private-mailbox-rental',
    'rental-agreement',
    'research',
    'service-area',
    'services',
    'shipping-partners',
    'sms-consent',
    'specialty',
    'terms',
    'thank-you',
    'tracking',
  ]);

  const seenSlugs = new Set<string>();
  const paths = [];

  for (const service of services) {
    if (!service.slug) continue;
    const cleanSlug = service.slug.replace(/^\//, '').replace(/\/$/, '');

    // Only route root-level slugs (no subdirectories) that are not static pages
    if (cleanSlug.includes('/')) continue;
    if (EXCLUDED_SLUGS.has(cleanSlug)) continue;
    if (seenSlugs.has(cleanSlug)) continue;

    seenSlugs.add(cleanSlug);
    paths.push({
      params: { slug: cleanSlug },
      props: { service },
    });
  }

  return paths;
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<ServiceLayout service={service} />
