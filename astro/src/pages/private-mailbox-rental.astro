---
// private-mailbox-rental.astro — Consumer / everyday-renter mailbox sales page
// Ported from the approved mockup: ~/work/mailbox-rental-redesign/index.html (Stages 1–8)
// Audience: everyday renters (NOT the business page — that stays at /home-business/mailbox-rental/)
// Direct-to-Stripe: the "Choose [tier]" buttons will deep-link into Stripe Checkout
//   once the create-checkout Netlify function is built. Until then they point at /contact-us/.

import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';
import { getWebPageSchema, getServiceSchema, getFAQSchema } from '../utils/schema';

const pageTitle = 'Private Mailbox Rental in Concord Township | Mailbox Plus';
const metaDescription =
  'Stop checking your phone for missed deliveries. Get a real Concord Township street address. All 4 carriers, from $15/month. Month-to-month, cancel anytime. Completely risk-free.';
const canonical = '/private-mailbox-rental/';

// FAQ schema for rich results (matching the visible FAQ section)
const faqs = [
  { question: "I'm not a business — can I still get a mailbox?", answer: "Absolutely. Most of our mailbox holders are everyday residents — people who get a lot of packages, want their mail off the porch, or just like knowing their home address isn't floating around in shipping databases. You don't need a business to rent one." },
  { question: 'Do I need ID to rent a mailbox?', answer: "Yes — two valid forms of ID are required. One primary photo ID (Passport, Driver's License) and one secondary ID showing your current address (Lease, Mortgage, or Insurance Policy). It's a USPS requirement (Form 1583), done in person." },
  { question: "Can I receive packages from all carriers?", answer: "Yes. FedEx, UPS, USPS, and DHL all deliver to your Mailbox Plus street address — no exceptions, no Street Addressing workarounds. We handle signature deliveries so you don't have to be home." },
  { question: "What's the difference between this and a PO Box?", answer: "A PO Box is a box number at the post office — carriers generally can't deliver packages to a PO Box number alone (unless USPS Street Addressing is available at that location), and you're locked into 3/6/12-month prepaid terms. Your Mailbox Plus address is a real street address with a box number, so all 4 carriers deliver, and you're on month-to-month with no lock-in." },
  { question: "What's your address look like on a label?", answer: "Your address is our street address plus your box number — e.g., 7554 Fredle Dr #234, Concord Township, OH 44077. It's a legitimate street address, not a PO Box number." },
  { question: 'Can businesses use this service?', answer: 'Absolutely. We support both individuals and businesses — LLCs, online sellers, remote workers, and home-based businesses use Mailbox Plus every day.' },
  { question: 'Can I cancel anytime?', answer: "Yes. We're month-to-month — no annual contract, no cancellation fee, no surprise charges. Just let us know." },
];

const webPageSchema = getWebPageSchema(siteConfig, {
  name: pageTitle,
  description: metaDescription,
  url: canonical,
  breadcrumbItems: [
    { name: 'Home', url: '/' },
    { name: 'Mailbox Rental', url: '/private-mailbox-rental/' },
  ],
  datePublished: '2026-08-23',
  dateModified: '2026-08-23',
});
const serviceSchema = getServiceSchema(siteConfig, {
  serviceName: 'Private Mailbox Rental',
  url: canonical,
  // Consumer 4-tier matrix (month-to-month only, new customers) + flat fees
  offers: [
    { name: 'Private Mailbox - Small Mail Only', price: '15.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Private Mailbox - Small +10 Packages', price: '25.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Private Mailbox - Large Mail Only', price: '30.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Private Mailbox - Large +10 Packages', price: '40.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Package Overage', price: '5.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Oversized Package Fee', price: '5.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Storage Fee (per day after 5 days)', price: '1.00', currency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Key Deposit (Refundable)', price: '5.00', currency: 'USD', availability: 'https://schema.org/InStock' },
  ],
  areaServed: siteConfig.areaServed,
  category: 'mailbox-rentals',
  serviceOutput: 'Private mailbox rental with real street address, package receiving, and mail services at Mailbox Plus Concord Township',
});
const faqSchema = getFAQSchema(siteConfig, faqs);
---

<BaseLayout title={pageTitle} description={metaDescription} canonical={canonical} ogImage="/og/private-mailbox-rental.png">
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <div class="trust-pill">
          <span class="stars">★★★★★</span>
          <span>5.0 rating · 44 verified Google reviews</span>
        </div>
        <h1>Stop Checking Your Phone for Another &ldquo;Missed Delivery&rdquo;</h1>
        <p class="subhead">Your packages should be waiting for you — not for thieves. A real Concord Township street address, all 4 carriers, from <strong>$15/month</strong>. We sign for your deliveries, so the next alert you get is the one that says &ldquo;ready for pickup.&rdquo;</p>
        <div class="hero-ctas">
          <a class="btn btn-gold btn-lg" href="#pricing">Get Your Lake County Address →</a>
        </div>
        <p class="hero-proof"><strong>Completely risk-free.</strong> Month-to-month. Cancel anytime. · Setup in ~10 minutes</p>
      </div>
      <div class="label-wrap">
        <div class="label-stamp">Real Street Address</div>
        <div class="label-card">
          <div class="tag">Where your packages will wait for you</div>
          <div class="addr-name">Your Name</div>
          <div class="addr-line">7554 Fredle Dr #234</div>
          <div class="addr-city">Concord Township, OH 44077</div>
          <div class="addr-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Not a P.O. Box
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ REINFORCEMENT WEDGE ============ -->
  <div class="wedge">
    <div class="container wedge-inner">
      <div class="wedge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        No 12-month lock-in
      </div>
      <div class="wedge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        10+ packages/mo on +10 plans
      </div>
      <div class="wedge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Text + email alerts on $25+ plans
      </div>
      <div class="wedge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        We sign deliveries on +10 plans
      </div>
    </div>
  </div>

  <!-- ============ BENEFITS (solution grid) ============ -->
  <section id="benefits">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">What you get</div>
        <h2>Your mail, handled so you never think about it</h2>
        <p>Every plan includes the things that actually protect your packages, your privacy, and your time.</p>
      </div>
      <div class="grid-3">
        <div class="card">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
          <h3>A real street address</h3>
          <p>Not a P.O. Box number. Your Mailbox Plus address is a legitimate Concord Township street address — and on +10 Package plans, all 4 carriers deliver to it, every time.</p>
        </div>
        <div class="card">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg></div>
          <h3>Your home stays private</h3>
          <p>Your home address never goes on another package or form again. We notify you within 4 hours — so you don't have to think about the mail at all.</p>
        </div>
        <div class="card">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h2m4 0h4M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
          <h3>Packages off your porch</h3>
          <p>No more &ldquo;left at front door&rdquo; photos, no more racing home, no more watching a delivery truck from the window. On +10 Package plans, your packages are signed for and held behind a locked counter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STORY: The missed-delivery loop ============ -->
  <section class="pt-0">
    <div class="container">
      <div class="story-block">
        <div>
          <div class="kicker">The problem nobody warns you about</div>
          <h3>The delivery system assumes you're home at 2 p.m.</h3>
          <p>&ldquo;Out for delivery&rdquo; at 9 a.m. means you're on the hook all day. Leave the office early. Cancel the errand. Keep one eye on the tracking app. Then, the one time you don't check — <em>&ldquo;We attempted delivery. Package will be available for pickup.&rdquo;</em></p>
          <p>That's not a delivery. That's a second job nobody asked for.</p>
        </div>
        <div class="story-visual">
          <div class="inner">
            <div class="visual-emoji">📱</div>
            <strong>9 a.m.: &ldquo;Out for delivery.&rdquo; 5 p.m.: &ldquo;Back at the depot.&rdquo;</strong>
            <p>The delivery system runs on its schedule, not yours.</p>
          </div>
        </div>
      </div>

      <div class="story-block">
        <div class="story-visual">
          <div class="inner">
            <div class="visual-emoji">☀️</div>
            <strong>The 9-to-5 tracking loop</strong>
            <p>Refresh at lunch. Refresh at 3. Refresh before you leave. Repeat all week.</p>
          </div>
        </div>
        <div>
          <div class="kicker">Why it grinds on you</div>
          <h3>You check the tracking app more than your email</h3>
          <p>9 a.m. — out for delivery. Noon — refresh. 2 p.m. — your heart skips when the status changes. 4 p.m. — nothing. Tomorrow the whole loop starts again.</p>
          <p>It's not that you're anxious — it's that the system never fits your life. You have a job, errands, a family. The carrier has a delivery window. Those two things don't line up, so the tracking app becomes your second screen.</p>
        </div>
      </div>

      <div class="story-block">
        <div>
          <div class="kicker">The part you can't control</div>
          <h3>When it finally arrives, it sits on your porch</h3>
          <p>And there it stays — visible to every passing car, every neighbor, every porch pirate. The delivery photo confirms it: &ldquo;Package left at front door.&rdquo; Now it's a race between you getting home and someone else grabbing it first.</p>
          <p>Rain. Theft. The &ldquo;I'll grab it when I get home&rdquo; that turns into &ldquo;it's gone.&rdquo; Your porch is the most public mailbox you could possibly have.</p>
        </div>
        <div class="story-visual">
          <div class="inner">
            <div class="visual-emoji">🏡</div>
            <strong>Front porch: the most public mailbox</strong>
            <p>Every box you order sits in plain sight until you get home.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMPETITIVE COMPARISON ============ -->
  <section class="banded">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">The honest comparison</div>
        <h2>Why a mailbox at Mailbox Plus beats the alternatives</h2>
        <p>The industry is full of lock-in contracts, package caps, and surprise fees. Here's what's actually true about each option.</p>
      </div>
      <div class="compare-wrap">
        <div class="compare-scroll">
          <table class="compare">
            <thead>
              <tr>
                <th></th>
                <th>USPS PO Box</th>
                <th>The UPS Store</th>
                <th class="win">Mailbox Plus</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Address type</strong></td>
                <td>PO Box number</td>
                <td>Street address + mailbox #</td>
                <td class="win-col"><strong>Real street address + #</strong></td>
              </tr>
              <tr>
                <td><strong>Term commitment</strong></td>
                <td class="x">3 / 6 / 12-month prepaid only — no month-to-month</td>
                <td class="x">6–12-month commitments common (terms vary by location)</td>
                <td class="win-col check">Month-to-month. Cancel anytime.</td>
              </tr>
              <tr>
                <td><strong>Package receiving</strong></td>
                <td>Slip + counter pickup on PO hours</td>
                <td class="x">Package caps + overage fees (vary by location)</td>
                <td class="win-col check">+10 tiers: all 4 carriers, 10+ pkgs/mo, we sign for deliveries</td>
              </tr>
              <tr>
                <td><strong>Extra fees</strong></td>
                <td>Prepaid you lose if you cancel early</td>
                <td class="x">Set-up, key, lock-change, forwarding (additional fees may apply)</td>
                <td class="win-col check">Clear flat rates: $5 oversized, $1/day storage after 5 days</td>
              </tr>
              <tr>
                <td><strong>Package size limits</strong></td>
                <td class="x">Oversize → slip or parcel-locker pickup on PO hours</td>
                <td class="x">May need a larger mailbox if your mail exceeds box size</td>
                <td class="win-col check">Oversized (over 18" or 20 lbs): $5 flat, still accepted</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <p class="muted text-center">Prices verified against USPS Painesville (44077), The UPS Store agreement templates, and Mailbox Plus — August 2026.</p>
    </div>
  </section>

  <!-- ============ PRICING (NEW 4-TIER MATRIX) ============ -->
  <section class="pricing" id="pricing">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Transparent pricing — what you see is what you pay</div>
        <h2>Pick your box. No surprises, no lock-in.</h2>
        <p>Month-to-month. Cancel anytime. No 3-month or 6-month terms, no discount games — just honest flat pricing.</p>
      </div>
      <div class="pricing-grid">
        <div class="price-card">
          <div class="tier">Small · Mail Only</div>
          <div class="price">$15<span>/mo</span></div>
          <div class="per">No lock-in · Cancel anytime</div>
          <ul>
            <li>Real street address (not a PO Box)</li>
            <li>Your box + unit number</li>
            <li>Secure, behind the counter</li>
          </ul>
          <a class="btn btn-outline checkout-btn" href="/contact-us/" data-tier="small_mail_only">Choose Small Mail Only →</a>
        </div>
        <div class="price-card featured">
          <div class="price-flag">Most Popular</div>
          <div class="tier">Small · +10 Packages</div>
          <div class="price">$25<span>/mo</span></div>
          <div class="per">No lock-in · Cancel anytime</div>
          <ul>
            <li>Real street address (not a PO Box)</li>
            <li><strong>All 4 carriers deliver</strong></li>
            <li><strong>We sign for packages</strong></li>
            <li><strong>10+ packages included</strong></li>
            <li>Beyond that: $5 per package</li>
            <li><strong>Text + email alerts</strong> for every item</li>
            <li>Best for frequent online shoppers</li>
          </ul>
          <a class="btn btn-warm checkout-btn" href="/contact-us/" data-tier="small_packages10">Choose Small +10 →</a>
        </div>
        <div class="price-card">
          <div class="tier">Large · Mail Only</div>
          <div class="price">$30<span>/mo</span></div>
          <div class="per">No lock-in · Cancel anytime</div>
          <ul>
            <li>Real street address (not a PO Box)</li>
            <li>Your box + unit number</li>
            <li>Roomier box for bulk mail</li>
            <li>Secure, behind the counter</li>
          </ul>
          <a class="btn btn-outline checkout-btn" href="/contact-us/" data-tier="large_mail_only">Choose Large Mail Only →</a>
        </div>
        <div class="price-card">
          <div class="tier">Large · +10 Packages</div>
          <div class="price">$40<span>/mo</span></div>
          <div class="per">No lock-in · Cancel anytime</div>
          <ul>
            <li>Real street address (not a PO Box)</li>
            <li><strong>All 4 carriers deliver</strong></li>
            <li><strong>We sign for packages</strong></li>
            <li><strong>10+ packages included</strong></li>
            <li>Beyond that: $5 per package</li>
            <li><strong>Text + email alerts</strong> for every item</li>
            <li>Room for everything</li>
          </ul>
          <a class="btn btn-outline checkout-btn" href="/contact-us/" data-tier="large_packages10">Choose Large +10 →</a>
        </div>
      </div>
      <p class="price-note">+10 Package tiers include 10+ packages/month, then $5 per package. Oversized packages (over 18" or 20 lbs): $5 flat. Held longer than 5 days: $1/day. Key deposit: $5 refundable. Existing customers keep their current rate — this pricing is for new customers.</p>
    </div>
  </section>

  <!-- ============ WHICH SIZE IS RIGHT FOR YOU ============ -->
  <section>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Which box is right for you</div>
        <h2>Two sizes. Pick the one that fits your mail.</h2>
        <p>Not sure what fits where? Here's the honest breakdown — and the part most people don't expect about packages.</p>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M3 8a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/></svg></div>
          <h3>Small Box</h3>
          <p class="size-desc">Perfect for everyday mail.</p>
          <ul class="size-list">
            <li>Letters &amp; bills</li>
            <li>Standard 8½" × 11" envelopes</li>
            <li>Legal-size documents</li>
            <li>Small flats &amp; folded mailers</li>
          </ul>
          <p class="size-best"><strong>Best for:</strong> households and light mail — the daily handful that lands on your doormat.</p>
        </div>
        <div class="card">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></div>
          <h3>Large Box</h3>
          <p class="size-desc">For people who get a lot of mail.</p>
          <ul class="size-list">
            <li>Magazines, catalogs &amp; brochures</li>
            <li>FedEx Express envelopes</li>
            <li>File folders &amp; bound documents</li>
            <li>Thick stacks of daily mail</li>
          </ul>
          <p class="size-best"><strong>Best for:</strong> subscriptions, professional documents, and anyone with more than a handful a day.</p>
        </div>
      </div>
      <div class="pkg-band">
        <div class="emoji">📦</div>
        <div class="body">
          <h3>Packages? Don't worry about box size.</h3>
          <p>Packages never have to fit inside your mailbox. They're kept on our secure storage shelves — protected, out of sight, and ready when you are. On +10 Package plans, we sign for them and you get a text + email the moment they arrive.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GUARANTEE ============ -->
  <div class="guarantee">
    <div class="container guarantee-inner">
      <div class="guarantee-badge">
        <div class="days">100%</div>
        <div class="label">Risk<br>Free</div>
      </div>
      <div>
        <h3>Try it. If it's not for you, walk away. No deadline.</h3>
        <p>No lock-in. No cancellation fee. No &ldquo;please stay&rdquo; guilt trip. You'll sign a simple agreement that spells out the rules — it just doesn't lock you in. We're month-to-month because we'd rather earn your business every month than trap you in a term.</p>
      </div>
    </div>
  </div>

  <!-- ============ HOW IT WORKS (1583) ============ -->
  <section id="how">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Quick &amp; easy setup</div>
        <h2>Setup takes about 10 minutes. We handle the paperwork.</h2>
        <p>USPS requires a short identity check (Form 1583) — we walk you through it. It's done once, in person, when you pick up your key.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">Step 1</div>
          <h3>Fill out the form</h3>
          <p>Complete USPS Form 1583 with your details. Each authorized recipient needs their own ID check.</p>
        </div>
        <div class="step">
          <div class="num">Step 2</div>
          <h3>Bring two IDs</h3>
          <p>One primary photo ID (Passport, Driver's License) and one secondary ID showing your current address (Lease, Mortgage, or Insurance Policy).</p>
        </div>
        <div class="step">
          <div class="num">Step 3</div>
          <h3>Start using it</h3>
          <p>Once verified, your new address is active immediately — for packages, returns, and everything else.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRE-LOSS PRICING CTA ============ -->
  <section class="preloss-cta">
    <div class="container">
      <a class="btn btn-gold btn-lg" href="#pricing">See Plans &amp; Pricing →</a>
      <p>Month-to-month · Cancel anytime · From $15/month</p>
    </div>
  </section>

  <!-- ============ LOSS / STAKES ============ -->
  <section class="banded">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">What's at stake</div>
        <h2>Every Package on Your Porch Is an Invitation</h2>
      </div>
      <div class="loss-grid">
        <div class="loss-card">
          <div class="emoji">🏠</div>
          <h3>Porch theft</h3>
          <p>Packages left on your doorstep are visible to every driver who passes. One delivery notification is all a thief needs. A Mailbox Plus box means everything is signed for and held behind a locked counter.</p>
        </div>
        <div class="loss-card">
          <div class="emoji">🔓</div>
          <h3>Privacy breach</h3>
          <p>Every package label in your trash has your home address on it. Every form you fill online feeds your address to data brokers who scrape and resell it. A real receiving address keeps your home off the grid.</p>
        </div>
        <div class="loss-card">
          <div class="emoji">📭</div>
          <h3>Missed deliveries</h3>
          <p>Not home when a package arrives? You get a redelivery slip and a trip to the depot. With a Mailbox Plus street address, all 4 carriers deliver every time — and we sign for you.</p>
        </div>
        <div class="loss-card">
          <div class="emoji">🚗</div>
          <h3>Redelivery runs</h3>
