---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Track a Package | Mailbox Plus — Concord Township, OH"
  description="Track your FedEx, UPS, USPS, or DHL package dropped off at Mailbox Plus in Concord Township, Ohio. Use carrier tracking portals or contact us for assistance."
>
  <section class="bg-gradient-to-br from-[var(--color-gradient-start)] via-[var(--color-gradient-mid)] to-[var(--color-gradient-end)] text-white py-16 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Track a Package</h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto">
        Use the links below to track your package with any major carrier.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-2 gap-6">
      <a href="https://www.fedex.com/fedextrack" target="_blank" rel="noopener noreferrer"
        class="block p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] shadow-sm hover:shadow-md transition-all">
        <h2 class="text-xl font-bold text-[var(--color-primary)] mb-2">FedEx Tracking</h2>
        <p class="text-sm text-[var(--color-text-secondary)]">Track FedEx Express, Ground, and Home Delivery shipments.</p>
      </a>
      <a href="https://www.ups.com/track" target="_blank" rel="noopener noreferrer"
        class="block p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] shadow-sm hover:shadow-md transition-all">
        <h2 class="text-xl font-bold text-[var(--color-primary)] mb-2">UPS Tracking</h2>
        <p class="text-sm text-[var(--color-text-secondary)]">Track UPS Ground, Air, and SurePost shipments.</p>
      </a>
      <a href="https://tools.usps.com/go/TrackConfirmAction_input" target="_blank" rel="noopener noreferrer"
        class="block p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] shadow-sm hover:shadow-md transition-all">
        <h2 class="text-xl font-bold text-[var(--color-primary)] mb-2">USPS Tracking</h2>
        <p class="text-sm text-[var(--color-text-secondary)]">Track USPS Priority Mail, First-Class, and Parcel Select shipments.</p>
      </a>
      <a href="https://www.dhl.com/us-en/home/tracking.html" target="_blank" rel="noopener noreferrer"
        class="block p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] shadow-sm hover:shadow-md transition-all">
        <h2 class="text-xl font-bold text-[var(--color-primary)] mb-2">DHL Tracking</h2>
        <p class="text-sm text-[var(--color-text-secondary)]">Track DHL Express and eCommerce shipments.</p>
      </a>
    </div>
    <div class="mt-12 p-6 rounded-2xl bg-[var(--color-bg-secondary)]/80 border border-[var(--color-border)] text-center">
      <h2 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">Need Help Tracking?</h2>
      <p class="text-sm text-[var(--color-text-secondary)] mb-4">If you dropped off a package with us and need help locating your tracking number, give us a call or stop by.</p>
      <a href="/contact-us/" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-semibold px-6 py-2 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">Contact Us</a>
    </div>
  </section>
</BaseLayout>
