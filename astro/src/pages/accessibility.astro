---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';

const accessibility = siteConfig.accessibility || {
  complianceStandard: 'WCAG 2.1 AA',
  contactEmail: 'accessibility@mailboxplusohio.com',
  phone: siteConfig.contact.phone,
  slas: {
    acknowledgmentDays: 2,
    resolutionDays: 10,
  },
};
---

<BaseLayout
  title="Accessibility Statement | Mailbox Plus"
  description="Mailbox Plus is committed to digital accessibility and WCAG 2.1 AA compliance. Report an accessibility barrier or request an accommodation."
  canonical="/accessibility"
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)] py-16 lg:py-24 text-center">
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold text-white tracking-tight mb-6">Accessibility Statement</h1>
      <p class="text-xl md:text-2xl text-white/80 leading-relaxed font-medium max-w-3xl mx-auto mb-6">
        Ensuring equal digital access, inclusive design, and continuous WCAG 2.1 AA compliance for all visitors.
      </p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-transparent to-[var(--color-bg-primary)] z-10"></div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Policy Commitment Card -->
    <section class="bg-[var(--color-bg-secondary)]/80 rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-6">
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">Our Commitment to Digital Accessibility</h2>
      <p class="text-base text-[var(--color-text-secondary)] leading-relaxed">
        Mailbox Plus of Ohio, LLC is dedicated to ensuring that our digital touchpoints are accessible to all visitors, including people with visual, hearing, cognitive, or motor disabilities. We actively align our website architecture with the Web Content Accessibility Guidelines (<strong>{accessibility.complianceStandard}</strong>).
      </p>
      <p class="text-base text-[var(--color-text-secondary)] leading-relaxed">
        Whether you access our site using screen readers, screen magnifiers, voice recognition software, or keyboard navigation, our goal is to provide a smooth, equitable user experience.
      </p>
    </section>

    <!-- Governance & Response SLAs -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] font-bold text-lg">
          {accessibility.slas.acknowledgmentDays}d
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)]">2-Day Acknowledgment SLA</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
          Every barrier report or accommodation request submitted through our public feedback form receives confirmation and personal acknowledgment within <strong>{accessibility.slas.acknowledgmentDays} business days</strong>.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] font-bold text-lg">
          {accessibility.slas.resolutionDays}d
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)]">10-Day Resolution SLA</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
          Reported visual, navigational, or content barriers are thoroughly evaluated and remediated within <strong>{accessibility.slas.resolutionDays} business days</strong> under our governance framework.
        </p>
      </div>
    </section>

    <!-- Technical Specs & Standards -->
    <section class="bg-[var(--color-bg-secondary)]/80 rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-6">
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">Technical Specifications & Accessibility Measures</h2>
      <ul class="space-y-4 text-sm text-[var(--color-text-secondary)]">
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Enforced Design Token Contrast:</strong> Color tokens meet WCAG 2.1 AA ratios (&ge;4.5:1 for normal body text, &ge;3.0:1 for large text and UI components) against warm paper backgrounds.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Screen Reader & ARIA Compatibility:</strong> Native semantic HTML markup, ARIA landmarks, and descriptive text labels support assistive technologies.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Keyboard Navigability:</strong> All interactive components, buttons, and form elements are reachable and operable via standard keyboard controls.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Automated CI Auditing:</strong> Pull requests and site updates are continuously tested using automated <code>@axe-core/cli</code> test suites to block accessibility regressions.</span>
        </li>
      </ul>
    </section>

    <!-- Report a Barrier Form Section -->
    <section class="bg-white rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">Report an Accessibility Barrier or Request an Accommodation</h2>
        <p class="text-sm text-[var(--color-text-secondary)] mt-2">
          If you encounter any difficulty accessing any content or feature on this website, please let us know using the form below. We will provide the information through an accessible alternative method and work quickly to remediate the barrier.
        </p>
      </div>

      <!-- SLA Assurance Banner -->
      <div class="bg-[var(--color-bg-primary)] border border-[var(--color-border-strong)] rounded-xl p-4 flex items-center gap-3">
        <svg class="w-6 h-6 text-[var(--color-accent-warm)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-xs sm:text-sm text-[var(--color-text-primary)] font-medium">
          <strong>Service Level Guarantee:</strong> Submissions receive formal acknowledgment within 2 business days and resolution within 10 business days as defined in site configuration governance.
        </p>
      </div>

      <form name="accessibility-barrier" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
        <input type="hidden" name="form-name" value="accessibility-barrier" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="acc-name" class="text-sm font-semibold text-[var(--color-text-primary)]">Full Name *</label>
            <input type="text" id="acc-name" name="name" required aria-label="Full name" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="Enter your full name" />
          </div>

          <div class="space-y-2">
            <label for="acc-email" class="text-sm font-semibold text-[var(--color-text-primary)]">Email Address *</label>
            <input type="email" id="acc-email" name="email" required aria-label="Email address" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="Enter your email address" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="acc-phone" class="text-sm font-semibold text-[var(--color-text-primary)]">Phone Number</label>
            <input type="tel" id="acc-phone" name="phone" aria-label="Phone number" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="(440) 555-0123" />
          </div>

          <div class="space-y-2">
            <label for="acc-url" class="text-sm font-semibold text-[var(--color-text-primary)]">Webpage URL / Feature Location</label>
            <input type="text" id="acc-url" name="url" aria-label="Webpage URL or feature location" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm" placeholder="e.g. /contact-us or service card dropdown" />
          </div>
        </div>

        <div class="space-y-2">
          <label for="acc-barrier" class="text-sm font-semibold text-[var(--color-text-primary)]">Description of Barrier or Accommodation Needed *</label>
          <textarea id="acc-barrier" name="barrier_description" required rows="5" aria-label="Description of accessibility barrier or accommodation needed" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm resize-none" placeholder="Please describe the barrier encountered or assistance required..."></textarea>
        </div>

        <div class="space-y-2">
          <label for="acc-preferred" class="text-sm font-semibold text-[var(--color-text-primary)]">Preferred Response Channel</label>
          <select id="acc-preferred" name="preferred_contact" aria-label="Preferred response channel" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] focus:border-[var(--color-accent-warm)] focus:ring-2 focus:ring-[var(--color-border-strong)] focus:outline-none transition-all shadow-sm">
            <option value="email">Email</option>
            <option value="phone">Phone Call</option>
            <option value="sms">SMS Text</option>
          </select>
        </div>

        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-[var(--color-primary)] text-white font-semibold text-base px-8 py-3.5 rounded-md hover:bg-[var(--color-primary-dark)] transition-all shadow-md">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          Submit Barrier Report (2-Day SLA Acknowledgment)
        </button>
      </form>
    </section>

    <!-- Alternative Contact Details -->
    <section class="bg-[var(--color-bg-secondary)]/80 rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-4">
      <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Alternative Communication Methods</h2>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        You can also reach our designated accessibility support team directly via email, phone, or in person:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-sm text-[var(--color-text-primary)]">
        <div>
          <strong>Email Support:</strong><br />
          <a href={`mailto:${accessibility.contactEmail}`} class="text-[var(--color-accent-warm)] font-medium hover:underline">{accessibility.contactEmail}</a>
        </div>
        <div>
          <strong>Phone Support:</strong><br />
          <a href={`tel:${siteConfig.contact.phone.replace(/[^0-9]/g, '')}`} class="text-[var(--color-accent-warm)] font-medium hover:underline">{accessibility.phone}</a>
        </div>
        <div>
          <strong>In-Store Visit:</strong><br />
          <span>{siteConfig.contact.address.street}, {siteConfig.contact.address.city}, {siteConfig.contact.address.state} {siteConfig.contact.address.zip}</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
