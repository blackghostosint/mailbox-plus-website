---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FormField } from '../components/ui/FormField';
import { IconWrapper } from '../components/ui/IconWrapper';
import { siteConfig } from '../config/siteConfig';

const accessibility = siteConfig.accessibility || {
  complianceStandard: 'WCAG 2.1 AA',
  contactEmail: siteConfig.contact.email,
  phone: siteConfig.contact.phone,
};
const recaptchaSiteKey =
  import.meta.env.VITE_RECAPTCHA_SITE_KEY || import.meta.env.RECAPTCHA_SITE_KEY || '';
---

<BaseLayout
  title="Accessibility Statement | Mailbox Plus"
  description="Mailbox Plus is committed to digital accessibility and WCAG 2.1 AA compliance. Report an accessibility barrier or request an accommodation."
  canonical="/accessibility"
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)] py-16 lg:py-24 text-center">
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold text-white tracking-tight mb-6">Accessibility Statement</h1>
      <p class="text-xl md:text-2xl text-white/80 leading-relaxed font-medium max-w-3xl mx-auto mb-6">
        Ensuring equal digital access, inclusive design, and continuous WCAG 2.1 AA compliance for all visitors.
      </p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-transparent to-[var(--color-bg-primary)] z-10"></div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Policy Commitment Card -->
    <section class="bg-[var(--color-bg-secondary)]/80 rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-6">
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">Our Commitment to Digital Accessibility</h2>
      <p class="text-base text-[var(--color-text-secondary)] leading-relaxed">
        Mailbox Plus of Ohio, LLC is dedicated to ensuring that our digital touchpoints are accessible to all visitors, including people with visual, hearing, cognitive, or motor disabilities. We actively align our website architecture with the Web Content Accessibility Guidelines (<strong>{accessibility.complianceStandard}</strong>).
      </p>
      <p class="text-base text-[var(--color-text-secondary)] leading-relaxed">
        Whether you access our site using screen readers, screen magnifiers, voice recognition software, or keyboard navigation, our goal is to provide a smooth, equitable user experience.
      </p>
    </section>

    <!-- Response Commitment -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] font-bold text-lg">
          <svg aria-hidden="true" focusable="false" class="w-5 h-5 text-[var(--color-accent-warm)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)]">Prompt Review & Support</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
          Every barrier report or accommodation request submitted through our public feedback form is reviewed promptly by our store team to assist you.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm space-y-3">
        <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] font-bold text-lg">
          <svg aria-hidden="true" focusable="false" class="w-5 h-5 text-[var(--color-accent-warm)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a2 2 0 01-2 2 2 2 0 01-2-2V4zM4 7a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-[var(--color-text-primary)]">Continuous Improvement</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
          Reported visual, navigational, or content barriers are evaluated and remediated as part of our ongoing digital accessibility updates.
        </p>
      </div>
    </section>

    <!-- Technical Specs & Standards -->
    <section class="bg-[var(--color-bg-secondary)]/80 rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-6">
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">Technical Specifications & Accessibility Measures</h2>
      <ul class="space-y-4 text-sm text-[var(--color-text-secondary)]">
        <li class="flex items-start gap-3">
          <svg aria-hidden="true" focusable="false" class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Enforced Design Token Contrast:</strong> Color tokens meet WCAG 2.1 AA ratios (&ge;4.5:1 for normal body text, &ge;3.0:1 for large text and UI components) against warm paper backgrounds.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg aria-hidden="true" focusable="false" class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Screen Reader & ARIA Compatibility:</strong> Native semantic HTML markup, ARIA landmarks, and descriptive text labels support assistive technologies.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg aria-hidden="true" focusable="false" class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Keyboard Navigability:</strong> All interactive components, buttons, and form elements are reachable and operable via standard keyboard controls.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg aria-hidden="true" focusable="false" class="w-5 h-5 text-[var(--color-accent-warm)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong>Automated CI Auditing:</strong> Pull requests and site updates are continuously tested using automated <code>@axe-core/cli</code> test suites to block accessibility regressions.</span>
        </li>
      </ul>
    </section>

    <!-- Report a Barrier Form Section -->
    <section class="bg-white rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">Report an Accessibility Barrier or Request an Accommodation</h2>
        <p class="text-sm text-[var(--color-text-secondary)] mt-2">
          If you encounter any difficulty accessing any content or feature on this website, please let us know using the form below. We will provide the information through an accessible alternative method and work quickly to remediate the barrier.
        </p>
      </div>

      <!-- Feedback Banner -->
      <div class="bg-[var(--color-bg-primary)] border border-[var(--color-border-strong)] rounded-xl p-4 flex items-center gap-3">
        <svg aria-hidden="true" focusable="false" class="w-6 h-6 text-[var(--color-accent-warm)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-xs sm:text-sm text-[var(--color-text-primary)] font-medium">
          <strong>Direct Feedback Channel:</strong> Barrier reports are delivered directly to our customer support team for timely assistance and review.
        </p>
      </div>

      <form name="accessibility-barrier" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-recaptcha-site-key={recaptchaSiteKey} class="space-y-6">
        <input type="hidden" name="form-name" value="accessibility-barrier" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <FormField id="acc-name" label="Full Name" required labelClassName="text-sm font-semibold text-[var(--color-text-primary)]">
            <input type="text" name="name" aria-label="Full name" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] transition-all shadow-sm" placeholder="Enter your full name" />
          </FormField>

          <FormField id="acc-email" label="Email Address" required labelClassName="text-sm font-semibold text-[var(--color-text-primary)]">
            <input type="email" name="email" aria-label="Email address" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] transition-all shadow-sm" placeholder="Enter your email address" />
          </FormField>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <FormField id="acc-phone" label="Phone Number" labelClassName="text-sm font-semibold text-[var(--color-text-primary)]">
            <input type="tel" name="phone" aria-label="Phone number" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] transition-all shadow-sm" placeholder="(440) 555-0123" />
          </FormField>

          <FormField id="acc-url" label="Webpage URL / Feature Location" labelClassName="text-sm font-semibold text-[var(--color-text-primary)]">
            <input type="text" name="url" aria-label="Webpage URL or feature location" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] transition-all shadow-sm" placeholder="e.g. /contact-us or service card dropdown" />
          </FormField>
        </div>

        <FormField id="acc-barrier" label="Description of Barrier or Accommodation Needed" required labelClassName="text-sm font-semibold text-[var(--color-text-primary)]">
          <textarea name="barrier_description" rows={5} aria-label="Description of accessibility barrier or accommodation needed" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] transition-all shadow-sm resize-none" placeholder="Please describe the barrier encountered or assistance required..."></textarea>
        </FormField>

        <FormField id="acc-preferred" label="Preferred Response Channel" labelClassName="text-sm font-semibold text-[var(--color-text-primary)]">
          <select name="preferred_contact" aria-label="Preferred response channel" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--color-border)] transition-all shadow-sm">
            <option value="email">Email</option>
            <option value="phone">Phone Call</option>
            <option value="sms">SMS Text</option>
          </select>
        </FormField>

        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-[var(--color-primary)] text-white font-semibold text-base px-8 py-3.5 rounded-md hover:bg-[var(--color-primary-dark)] transition-all shadow-md">
          <IconWrapper><svg aria-hidden="true" focusable="false" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></IconWrapper>
          Submit Barrier Report
        </button>
      </form>
    </section>

    <!-- Alternative Contact Details -->
    <section class="bg-[var(--color-bg-secondary)]/80 rounded-2xl p-8 border border-[var(--color-border)] shadow-md space-y-4">
      <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Alternative Communication Methods</h2>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        You can also reach our designated accessibility support team directly via email, phone, or in person:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-sm text-[var(--color-text-primary)]">
        <div>
          <strong>Email Support:</strong><br />
          <a href={`mailto:${accessibility.contactEmail}`} class="text-[var(--color-accent-warm)] font-medium hover:underline">{accessibility.contactEmail}</a>
        </div>
        <div>
          <strong>Phone Support:</strong><br />
          <a href={`tel:${siteConfig.contact.phone.replace(/[^0-9]/g, '')}`} class="text-[var(--color-accent-warm)] font-medium hover:underline">{accessibility.phone}</a>
        </div>
        <div>
          <strong>In-Store Visit:</strong><br />
          <span>{siteConfig.contact.address.street}, {siteConfig.contact.address.city}, {siteConfig.contact.address.state} {siteConfig.contact.address.zip}</span>
        </div>
      </div>
    </section>
  </div>

  <script>
  import { initContactForms } from '../lib/contact-form';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForms);
  } else {
    initContactForms();
  }
</script>
</BaseLayout>
