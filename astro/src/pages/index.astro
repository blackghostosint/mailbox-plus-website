---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../config/siteConfig'
const phoneDigits = siteConfig.contact.phone.replace(/[^0-9]/g, '')
const localAreas = ['Concord Township','Mentor','Painesville','Eastlake','Willoughby','Wickliffe','Madison','Perry','Kirtland','Chardon','Fairport Harbor','Geneva']
const star = '<svg class="w-4 h-4 fill-yellow-400 text-yellow-400" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'
---
<BaseLayout 
  title="Mailbox Plus | Pack, Ship, Mailbox Rentals & Notary | Concord Township, OH"
  description="Mailbox Plus in Concord Township (44077): UPS/FedEx/DHL/USPS shipping, private mailbox rentals, notary, printing. 5.0★ from 32 reviews. Call (440) 709-1946."
>
  <!-- HERO -->
  <section class="relative bg-center py-20 md:py-32 lg:py-48 overflow-hidden min-h-[70vh] md:min-h-[80vh]">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)]"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.15] mb-8">Mailbox Plus: Shipping, Returns, and Private Mailboxes</h1>
      <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-[var(--color-accent-warm)] leading-relaxed mb-8">Four carriers, one counter, no runaround.</p>
      <p class="text-lg sm:text-xl md:text-2xl text-white/80 leading-loose max-w-3xl mx-auto mb-6">Shipping shouldn't cost you an hour. Stop running around Lake County for returns or carrier drop-offs.</p>
      <p class="text-base sm:text-lg font-semibold text-white/90 tracking-widest uppercase mb-4">Mailbox Plus — Your Local Pack & Ship in Concord Township</p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-[var(--color-bg-primary)]"></div>
  </section>

  <!-- SERVICE CARDS -->
  <section class="py-16 md:py-24 bg-[var(--color-bg-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Ship a Package -->
        <div class="bg-[var(--color-bg-secondary)] rounded-2xl p-6 shadow-sm border border-[var(--color-border)] hover:shadow-lg hover:-translate-y-1 transition-all duration-250 group flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] mb-4 group-hover:bg-[var(--color-accent-warm)]/15 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">Ship a Package</h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-3 flex-1">UPS, FedEx, USPS, DHL — we compare rates and get it out same day.</p>
          <a href="/pack-ship" class="mt-auto inline-flex items-center text-sm font-semibold text-[var(--color-accent-warm)] hover:text-[var(--color-accent-warm-light)] transition-colors">Get Started <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
        </div>
        <!-- Return an Order -->
        <div class="bg-[var(--color-bg-secondary)] rounded-2xl p-6 shadow-sm border border-[var(--color-border)] hover:shadow-lg hover:-translate-y-1 transition-all duration-250 group flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] mb-4 group-hover:bg-[var(--color-accent-warm)]/15 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">Return an Order</h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-3 flex-1">FedEx, UPS, USPS, Amazon — doesn't matter who the label's from, we scan it and it's gone.</p>
          <a href="/pack-ship/package-receiving" class="mt-auto inline-flex items-center text-sm font-semibold text-[var(--color-accent-warm)] hover:text-[var(--color-accent-warm-light)] transition-colors">Drop Off a Return <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
        </div>
        <!-- Private Mailbox -->
        <div class="bg-[var(--color-bg-secondary)] rounded-2xl p-6 shadow-sm border border-[var(--color-border)] hover:shadow-lg hover:-translate-y-1 transition-all duration-250 group flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] mb-4 group-hover:bg-[var(--color-accent-warm)]/15 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">Private Mailbox</h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-3 flex-1">A real street address for your business or privacy. All-carrier package acceptance, no porch theft.</p>
          <a href="/home-business/mailbox-rental" class="mt-auto inline-flex items-center text-sm font-semibold text-[var(--color-accent-warm)] hover:text-[var(--color-accent-warm-light)] transition-colors">See Options <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
        </div>
        <!-- Notary & More -->
        <div class="bg-[var(--color-bg-secondary)] rounded-2xl p-6 shadow-sm border border-[var(--color-border)] hover:shadow-lg hover:-translate-y-1 transition-all duration-250 group flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-accent-warm)]/10 flex items-center justify-center text-[var(--color-accent-warm)] mb-4 group-hover:bg-[var(--color-accent-warm)]/15 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">Notary & More</h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-3 flex-1">Notary, shredding, fingerprinting — everything else your errand list needs, one counter.</p>
          <a href="/home-business/notary-services" class="mt-auto inline-flex items-center text-sm font-semibold text-[var(--color-accent-warm)] hover:text-[var(--color-accent-warm-light)] transition-colors">Learn More <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- VISIT US -->
  <section id="visit-us" class="py-24 md:py-32 lg:py-36 bg-[var(--color-bg-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- CTA Button -->
      <div class="mb-14">
        <a href="/pack-ship" class="inline-flex items-center gap-2 bg-[var(--color-accent-gold)] text-[var(--color-text-primary)] font-bold text-base sm:text-lg px-10 py-5 rounded-md hover:brightness-110 transition-all shadow-lg">
          Get Started Shipping <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <p class="text-2xl md:text-4xl font-bold text-[var(--color-text-secondary)] mb-4 max-w-3xl mx-auto">Next to Pub Frato in Gristmill Village — serving all of Lake County</p>
      <p class="text-lg text-[var(--color-text-muted)] mb-14 max-w-2xl mx-auto">Stop by Mailbox Plus for all your shipping, printing, and business service needs. We are ready to help you.</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="https://www.google.com/maps/dir/?api=1&destination=41.66497,-81.24164" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-semibold px-6 py-3 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Get Directions
        </a>
        <a href="https://www.google.com/maps/@41.66497,-81.24164,17z" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-semibold px-6 py-3 rounded-md hover:bg-[var(--color-primary)]/5 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          View on Map
        </a>
        <a href={`tel:${phoneDigits}`} class="inline-flex items-center gap-2 text-[var(--color-accent-warm)] font-semibold px-6 py-3 rounded-md hover:bg-[var(--color-accent-warm)]/10 transition-all border-2 border-transparent">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Call {siteConfig.contact.phone}
        </a>
      </div>

      <div class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] mb-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-sm">Mon-Fri: 9AM-6PM | Sat: 9AM-2PM | Sun: Closed</span>
      </div>

      <!-- Rating -->
      <div class="mb-14 flex flex-col items-center justify-center">
        <a href="https://g.page/r/CyYNUX4atT3PEBM/review" target="_blank" rel="noopener noreferrer" class="group inline-flex flex-col items-center p-6 md:p-8 bg-white/70 backdrop-blur border border-[var(--color-border)] rounded-[28px] shadow-sm hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3">
            <span class="text-[var(--color-accent-gold)] text-2xl md:text-3xl font-bold">★★★★★</span>
            <span class="text-lg md:text-xl font-bold text-[var(--color-text-primary)]">{siteConfig.aggregateRating?.ratingValue || 5.0} / 5.0</span>
          </div>
          <p class="text-sm md:text-base font-bold text-[var(--color-text-primary)] mt-2 group-hover:text-[var(--color-accent-warm)] transition-colors">Based on {siteConfig.aggregateRating?.reviewCount || 32} Verified Google Reviews</p>
        </a>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="py-16 bg-[var(--color-bg-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-primary)] mb-10">Service Areas</h2>
      <div class="flex flex-wrap gap-4 justify-center">
        {localAreas.map((area) => {
          const slug = area.toLowerCase().replace(/\s+/g, '-');
          return (
            <a href={`/service-area/${slug}`} class="inline-flex items-center px-5 py-2.5 rounded-full border-2 border-[var(--color-primary)] bg-white text-[var(--color-primary)] font-semibold text-sm hover:bg-[var(--color-accent-warm)]/10 hover:border-[var(--color-accent-warm)] transition-all">{area}</a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- JSON-LD Structured Data for LocalBusiness -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Mailbox Plus",
      "legalName": "Mailbox Plus of Ohio, LLC",
      "image": [
        "https://pub-21518ce3034449a3a7b5a0b89551f710.r2.dev/mailbox_plus_logo.webp"
      ],
      "@id": "https://mailboxplusohio.com/",
      "url": "https://mailboxplusohio.com/",
      "telephone": "+1-440-709-1946",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "7554 Fredle Drive",
        "addressLocality": "Concord Township",
        "addressRegion": "OH",
        "postalCode": "44077",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 41.6591,
        "longitude": -81.2389
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "32",
        "ratingCount": "32",
        "bestRating": "5",
        "worstRating": "1"
      },
      "servesArea": [
        "Concord Township, OH",
        "Painesville, OH",
        "Mentor, OH",
        "Chardon, OH",
        "Willoughby, OH",
        "Eastlake, OH",
        "Madison, OH",
        "Perry, OH",
        "Kirtland, OH",
        "Fairport Harbor, OH",
        "Geneva, OH",
        "Wickliffe, OH",
        "Willoughby Hills, OH"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Pack & Ship Services",
            "url": "https://mailboxplusohio.com/pack-ship/"
          },
          {
            "@type": "Offer",
            "name": "Private Mailbox Rental",
            "url": "https://mailboxplusohio.com/home-business/mailbox-rental/"
          },
          {
            "@type": "Offer",
            "name": "Notary Services",
            "url": "https://mailboxplusohio.com/home-business/notary-services/"
          },
          {
            "@type": "Offer",
            "name": "Printing & Copying",
            "url": "https://mailboxplusohio.com/copy-print/"
          },
          {
            "@type": "Offer",
            "name": "Fingerprinting",
            "url": "https://mailboxplusohio.com/specialty/digital-fingerprinting/"
          }
        ]
      },
      "sameAs": [
        "https://www.facebook.com/MailboxPlusOH",
        "https://www.yelp.com/biz/mailbox-plus-concord-township",
        "https://www.bing.com/places?id=...",
        "https://www.apple.com/maps/place/..."
      ]
    }
    </script>
</BaseLayout>