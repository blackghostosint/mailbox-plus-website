---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accept Invitation | Mailbox Plus" description="Accept your staff invitation to Mailbox Plus." noindex>
  <section class="min-h-[50vh] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)] mb-4">Staff Invitation</h1>
      <p class="text-[var(--color-text-secondary)] mb-4">This invitation page is not yet available. Please contact the store for assistance.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-semibold px-6 py-2 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">Back to Home</a>
    </div>
  </section>
</BaseLayout>
