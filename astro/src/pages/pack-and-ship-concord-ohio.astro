---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Pack & Ship Services in Concord Township, OH | UPS, FedEx, DHL, USPS | Mailbox Plus"
  description="Full-service packing and shipping in Concord Township (44077). We handle UPS, FedEx, DHL, and USPS shipments, custom crating, freight, and specialty items. Open Sat 9-2. 5.0★ from 32 Google reviews. Call (440) 709-1946."
>
  <!-- JSON-LD Structured Data for Service and LocalBusiness -->
  <script is:inline type="application/ld+json">
    {
      json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Pack & Ship Services",
      "description": "Full-service packing and shipping in Concord Township (44077). We handle UPS, FedEx, DHL, and USPS shipments, custom crating, freight, and specialty items.",
      "areaServed": {
        "@type": "Place",
        "name": "Concord Township, OH",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Concord Township",
          "addressRegion": "OH",
          "postalCode": "44077",
          "addressCountry": "US"
        }
      },
      "provider": {
        "@type": "LocalBusiness",
        "name": "Mailbox Plus",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "7554 Fredle Drive",
          "addressLocality": "Concord Township",
          "addressRegion": "OH",
          "postalCode": "44077"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "32"
        }
      },
      "offers": {
        "@type": "Offer",
        "name": "Standard Pack & Ship",
        "priceCurrency": "USD",
        "priceRange": "Starting at $15.99"
      }
    }
    </script>

  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-center mb-8 text-[var(--color-primary)]">
      Pack & Ship Services in Concord Township, OH
    </h1>
    
    <div class="grid gap-8 md:grid-cols-2">
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-[var(--color-primary-dark)]">
          Why Choose Mailbox Plus for Pack & Ship?
        </h2>
        <ul class="list-disc list-inside space-y-3 text-[var(--color-text-secondary)]">
          <li>Official UPS, FedEx, DHL & USPS authorized shipper</li>
          <li>Expert packing for fragile, valuable, and oversized items</li>
          <li>Same-day processing for most shipments</li>
          <li>Free packing materials with select services</li>
          <li>Online tracking and insurance options available</li>
          <li>Notary public on-site for shipping documents</li>
          <li>Competitive rates - often cheaper than carrier stores</li>
          <li>Convenient location with ample parking</li>
          <li>5.0-star rating from 32 verified Google reviews</li>
        </ul>
      </div>
      
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-[var(--color-primary-dark)]">
          Our Shipping Services
        </h2>
        <div class="space-y-4">
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Domestic Shipping</h3>
            <p class="text-[var(--color-text-secondary)]">UPS Ground, FedEx Ground, USPS Priority Mail, and more. We compare rates to get you the best price.</p>
          </div>
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">International Shipping</h3>
            <p class="text-[var(--color-text-secondary)]">Ship to over 220 countries with DHL Express, FedEx International, and USPS Global Express.</p>
          </div>
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Freight & LTL</h3>
            <p class="text-[var(--color-text-secondary)]">Palletized shipments, liftgate service, and residential delivery options available.</p>
          </div>
          <div class="border rounded-lg p-4">
            <h3 class="font-semibold mb-2">Specialty Items</h3>
            <p class="text-[var(--color-text-secondary)]">We expertly pack and ship: artwork, antiques, musical instruments, electronics, and trade show materials.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t pt-8">
      <h2 class="text-2xl font-semibold text-[var(--color-primary-dark)] mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">Do I need an account to ship with you?</h3>
          <p class="text-[var(--color-text-secondary)]">No! We accept walk-in shipments from the general public. No account or minimum volume required.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">What are your hours?</h3>
          <p class="text-[var(--color-text-secondary)]">Monday-Friday: 9AM-6PM, Saturday: 9AM-2PM. Closed Sundays and major holidays.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">Can you pack my items for me?</h3>
          <p class="text-[var(--color-text-secondary)]">Yes! Our professional packing service starts at $15. We use industry-standard materials and techniques to ensure your items arrive safely.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="font-semibold mb-2">Do you offer discounts for businesses?</h3>
          <p class="text-[var(--color-text-secondary)]">Absolutely. We provide volume discounts for businesses that ship regularly. Ask about our commercial shipping program.</p>
        </div>
      </div>
    </div>

    <div class="mt-16 text-center">
      <a href="tel:4407091946" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-semibold px-6 py-3 rounded-md hover:bg-[var(--color-primary-dark)] transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        Call Now for a Shipping Quote: (440) 709-1946
      </a>
    </div>
  </div>
</BaseLayout>