---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarrierPickupCard from '../components/CarrierPickupCard.astro';

const carriers = [
  {
    carrierName: 'USPS',
    title: 'USPS Pickup',
    accentColor: 'text-[var(--color-accent-warm)]',
    iconPath: 'M12 6.5a3.5 3.5 0 110 7 3.5 3.5 0 010-7zM12 4a8 8 0 110 16 8 8 0 010-16z',
    schedule: [
      { days: 'Monday – Friday:', hours: '2:30 PM' },
      { days: 'Saturday:', hours: '12:00 PM (Noon)' },
      { days: 'Sunday:', hours: 'No pickup' },
    ],
    notes: 'Accepts stamped mail, prepaid labels, Priority Mail, and returns.',
  },
  {
    carrierName: 'UPS',
    title: 'UPS Pickup',
    accentColor: 'text-[var(--color-accent-warm)]',
    iconPath: 'M3 7h18M3 12h18M3 17h18',
    schedule: [
      { days: 'Monday – Friday:', hours: '4:00 PM' },
      { days: 'Saturday:', hours: 'No pickup' },
      { days: 'Sunday:', hours: 'No pickup' },
    ],
    notes: 'Accepts pre-labeled drop-offs, Amazon returns (with label), and air/ground packages.',
  },
  {
    carrierName: 'FedEx Express',
    title: 'FedEx Express',
    accentColor: 'text-[var(--color-primary)]',
    iconPath: 'M12 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 2a.5.5 0 01.5-.5h3a.5.5 0 010 1h-3a.5.5 0 01-.5-.5zm0 4a.5.5 0 01.5-.5h2a.5.5 0 010 1h-2a.5.5 0 01-.5-.5z',
    schedule: [
      { days: 'Monday – Friday:', hours: '5:00 PM' },
      { days: 'Saturday:', hours: '12:00 PM (Noon)' },
      { days: 'Sunday:', hours: 'No pickup' },
    ],
    notes: 'For overnight, 2-day, and express saver shipments. Separate from Ground.',
  },
  {
    carrierName: 'FedEx Ground',
    title: 'FedEx Ground',
    accentColor: 'text-[var(--color-accent-warm)]',
    iconPath: 'M12 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 2a.5.5 0 01.5-.5h3a.5.5 0 010 1h-3a.5.5 0 01-.5-.5zm0 4a.5.5 0 01.5-.5h2a.5.5 0 010 1h-2a.5.5 0 01-.5-.5z',
    schedule: [
      { days: 'Monday – Friday:', hours: '4:00 PM' },
      { days: 'Saturday:', hours: 'No pickup' },
      { days: 'Sunday:', hours: 'No pickup' },
    ],
    notes: 'Standard ground shipping and Home Delivery packages.',
  },
];
---
<BaseLayout>
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="mb-6 text-3xl font-bold text-[var(--color-primary)] text-center">Carrier Pickup Hours</h1>
    <p class="mb-8 text-[var(--color-text-secondary)] text-center max-w-2xl mx-auto">
      Knowing the exact pickup times ensures your important shipments go out the same day. We are an authorized ship center for UPS, FedEx, and USPS. Residents of Concord Township, Mentor, and Painesville rely on us for timely processing.
    </p>

    <div class="grid gap-6 md:grid-cols-2">
      {carriers.map((carrier) => (
        <CarrierPickupCard
          carrierName={carrier.carrierName}
          title={carrier.title}
          accentColor={carrier.accentColor}
          schedule={carrier.schedule}
          notes={carrier.notes}
        >
          <svg
            slot="icon"
            aria-hidden="true"
            focusable="false"
            class:list={["w-5 h-5 mr-2", carrier.accentColor]}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={carrier.iconPath} />
          </svg>
        </CarrierPickupCard>
      ))}
    </div>

    {/* Holiday Schedule */}
    <div class="mt-12">
      <h2 class="mb-4 text-2xl font-semibold text-[var(--color-primary)]">Holiday Schedule</h2>
      <p class="mb-4 text-[var(--color-text-secondary)]">
        We observe the following holidays and may have adjusted pickup times. Please call ahead for holiday schedules:
      </p>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li>New Year's Day</li>
        <li>Memorial Day</li>
        <li>Independence Day</li>
        <li>Labor Day</li>
        <li>Thanksgiving Day</li>
        <li>Christmas Day</li>
      </ul>
    </div>
  </div>
</BaseLayout>
