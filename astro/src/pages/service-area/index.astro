---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serviceAreas } from '../../config/serviceAreas';

const areas = serviceAreas.filter(a => !a.id.startsWith('faq-'));
---

<BaseLayout
  title="Service Area | Mailbox Plus — Concord Township, OH"
  description="Serving Concord Township, Mentor, Painesville, Willoughby, Eastlake, and all of Lake County, Ohio with shipping, printing, mailbox rentals, and more."
>
  <section class="bg-gradient-to-br from-[var(--color-gradient-start)] via-[var(--color-gradient-mid)] to-[var(--color-gradient-end)] text-white py-16 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Service Area</h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto">
        Proudly serving Lake County, Ohio, and surrounding communities. Shipping shouldn't cost you an hour.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {areas.map((area) => (
        <a
          href={`/service-area/${area.slug}/`}
          class="block rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 hover:bg-[var(--color-bg-secondary)] p-6 shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
        >
          <h2 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">{area.serviceName}</h2>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{area.metaDescription?.slice(0, 160)}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
