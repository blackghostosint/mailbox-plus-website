|---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewSection from '../components/ReviewSection.astro';
import { siteConfig } from '../config/siteConfig';
import { getLocalBusinessSchema } from '../utils/schema';
import { toCanonicalUrl } from '../utils/canonical-url';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, canonical, noindex, ogImage } = Astro.props;
const siteUrl = 'https://mailboxplusohio.com';
// Emit a self-referencing canonical for every indexable page. Pages that
// explicitly pass `canonical` use it; otherwise default to the current page
// URL so no indexable page ships without a canonical (GSC flags such pages
// as "Duplicate without user-selected canonical" when alternate URL forms
// exist). noindex pages (404, accept-invite) get no canonical.
const canonicalUrl = canonical
  ? toCanonicalUrl(canonical)
  : noindex
    ? undefined
    : toCanonicalUrl(Astro.url.pathname);
const fallbackUrl = toCanonicalUrl('/');

const localBusinessSchema = getLocalBusinessSchema(siteConfig);

// OG image URL resolution.
// - Explicit ogImage prop: used as-is (absolute URL or site-relative path).
// - No ogImage: fall back to the shared default brand card (/og/default.png).
//   We intentionally do NOT derive a per-page /og/{slug}.png — those files
//   are only generated for pages that opt in by passing ogImage, so a derived
//   path would 404 for every other page and break social share previews.
//   (Historical bug: pages with an absolute canonical produced garbage paths
//   like /og/https:--mailboxplusohio.com-...png; pages with no canonical
//   pointed at a never-generated /og/home.png. Both now resolve to the
//   default card.)
const DEFAULT_OG = '/og/default.png';
const canonicalPath = (canonical || '')
  .replace(/^https?:\/\/[^/]+/, '') // strip scheme + host if a full URL
  .replace(/^\//, '')
  .replace(/\/$/, '')
  .replace(/\//g, '-');
const ogPath = ogImage
  ? (ogImage.startsWith('http') || ogImage.startsWith('/')
      ? ogImage
      : `/og/${canonicalPath || 'home'}.png`)
  : DEFAULT_OG;
const absoluteOgImage = ogPath.startsWith('http') ? ogPath : `${siteUrl}${ogPath}`;
// Only declare 1200x630 for auto-generated /og/*.png cards. Pages that pass a
// custom ogImage (e.g. article R2 feature images, 1024x576) omit width/height
// so social crawlers fetch and use the real dimensions instead of a mismatch.
const ogImageWidth = ogImage ? undefined : '1200';
const ogImageHeight = ogImage ? undefined : '630';
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="facebook-domain-verification" content="r8xszvoqen5sjb7df0ab7m7ox9mbb2" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="llms-txt" href="/llms.txt" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" /></noscript>
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl || fallbackUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <!-- Deferred Third-Party Analytics (GA4 + Meta Pixel) -->
    <script is:inline>
      (function() {
        // Initialize GA4 dataLayer & gtag
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function() {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());

        // Timezone-gated GA4 page_view filter
        var tz = typeof Intl !== 'undefined' && Intl.DateTimeFormat ? Intl.DateTimeFormat().resolvedOptions().timeZone : null;
        var isNA = tz && (tz.startsWith('America/') || tz === 'Pacific/Honolulu');
        window.gtag('config', 'G-W2J1KV96YJ', { send_page_view: isNA });

        // Initialize Meta Pixel queue
        if (!window.fbq) {
          var n = window.fbq = function() {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!window._fbq) window._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];
        }
        window.fbq('init', '1684128789653811');
        window.fbq('track', 'PageView');

        // Lazy-load function
        var trackingSDKsLoaded = false;
        function loadTrackingSDKs() {
          if (trackingSDKsLoaded) return;
          trackingSDKsLoaded = true;

          // Remove interaction listeners
          var events = ['click', 'scroll', 'touchstart', 'mousemove', 'keydown'];
          events.forEach(function(e) {
            window.removeEventListener(e, loadTrackingSDKs, { passive: true });
          });

          // Load GA4 SDK
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-W2J1KV96YJ';
          document.head.appendChild(gaScript);

          // Load Meta Pixel SDK
          var fbScript = document.createElement('script');
          fbScript.async = true;
          fbScript.src = 'https://connect.facebook.net/en_US/fbevents.js';
          document.head.appendChild(fbScript);
        }

        // Attach interaction listeners
        var events = ['click', 'scroll', 'touchstart', 'mousemove', 'keydown'];
        events.forEach(function(e) {
          window.addEventListener(e, loadTrackingSDKs, { passive: true, once: true });
        });

        // Setup idle trigger
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(function() {
            loadTrackingSDKs();
          }, { timeout: 2000 });
        } else {
          window.setTimeout(loadTrackingSDKs, 2000);
        }
      })();
    </script>
    <!-- End Deferred Third-Party Analytics -->
    <!-- Google Preferred Sources button library -->
    <!-- SRI intentionally omitted: this is Google's documented embed code from news.google.com (first-party CDN) -->
    <script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
  </head>
  <body class="bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] font-sans min-h-screen flex flex-col">
    <!-- Meta Pixel Code (noscript) -->
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1684128789653811&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-primary)] focus:text-white focus:rounded focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-border-strong)]"
    >
      Skip to main content
    </a>

    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <ReviewSection />
    <Footer />
  </body>
</html>
