      <linearGradient id="cs-kraft-side" x1="150" y1="198" x2="210" y2="318" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--color-bg-warm-tint)" />
        <stop offset="100%" stop-color="var(--color-border-strong)" />
      </linearGradient>
      <clipPath id="cs-frame-clip">
        <rect x="16" y="16" width="528" height="408" rx="28" />
      </clipPath>
    </defs>

    <g clip-path="url(#cs-frame-clip)">
