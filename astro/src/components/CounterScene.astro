---
// CounterScene.astro — bespoke inline SVG "Concord Counter Scene" (DESIGN_PHASE1_SPEC §3.1, §4 Task 5).
// Inline markup ~11 KB, zero external assets, strictly decorative (aria-hidden, never LCP).
// Token-native colours from global.css; static fallback with JS off; GSAP transform/opacity hooks.
---

<div id="hero-counter-scene" data-counter-scene aria-hidden="true" class="relative select-none pointer-events-none">
  <svg viewBox="0 0 560 440" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="w-full h-auto drop-shadow-xl">
    <defs>
      <linearGradient id="cs-card-bg" x1="40" y1="20" x2="520" y2="410" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--color-primary-deeper)" />
        <stop offset="100%" stop-color="var(--color-primary-deep)" />
      </linearGradient>
      <linearGradient id="cs-beam-cone" x1="286" y1="86" x2="286" y2="258" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--color-accent-gold-light)" stop-opacity="0.46" />
        <stop offset="65%" stop-color="var(--color-accent-gold)" stop-opacity="0.16" />
        <stop offset="100%" stop-color="var(--color-accent-gold)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="cs-counter-top" x1="28" y1="318" x2="532" y2="352" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--color-bg-primary)" />
        <stop offset="100%" stop-color="var(--color-bg-secondary)" />
      </linearGradient>
      <linearGradient id="cs-kraft-front" x1="200" y1="192" x2="366" y2="318" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--color-bg-primary)" />
        <stop offset="100%" stop-color="var(--color-bg-warm-tint)" />
