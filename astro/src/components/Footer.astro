---
// Footer.astro — site footer. DESIGN_PHASE1_SPEC §3.3 typography (display face on headings,
// 20px-min text for the 40+ audience) and §3.4 palette (terracotta on paper; gold is
// reserved for interactive states and never used here).
import { siteConfig } from '../config/siteConfig';
import OutboundLink from './ui/OutboundLink.astro';
const phoneDigits = siteConfig.contact.phone.replace(/[^0-9]/g, '');
const quickLinks = [
  { name: 'Pack & Ship', href: '/pack-ship/' },
  { name: 'FedEx Shipping', href: '/pack-ship/fedex-shipping/' },
  { name: 'UPS Shipping', href: '/pack-ship/ups-authorized-shipper-outlet/' },
  { name: 'Copy & Print', href: '/copy-print/' },
  { name: 'Mailbox Rental', href: '/private-mailbox-rental/' },
  { name: 'Notary Services', href: '/home-business/notary-services/' },
  { name: 'Ask Mailbox Plus', href: '/ask-mailbox-plus/' },
  { name: 'Shipping Partners', href: '/shipping-partners/' },
  { name: 'DHL Express', href: '/pack-ship/dhl-express/' },
  { name: 'Specialty Services', href: '/specialty/digital-fingerprinting/' },
  { name: 'Every Door Direct Mail', href: '/home-business/every-door-direct-mail/' },
];
---

<footer class="bg-[var(--color-bg-secondary)] border-t border-[var(--color-border)]">
  <!-- Tagline Bar -->
  <div class="bg-[var(--color-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
      <h2 class="font-display text-[length:var(--text-step-2)] leading-tight font-bold text-white">{siteConfig.tagline}</h2>
    </div>
  </div>

  <!-- Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-x-12">
      <!-- Company Info (full row on 2-col tablets so the remaining four blocks pair up) -->
      <div class="space-y-4 md:col-span-2 lg:col-span-1">
        <div class="flex items-center">
          <img src="/logo.webp" alt="Mailbox Plus Logo" width="256" height="80" class="h-20 w-auto object-contain" />
        </div>
        <p class="text-[length:var(--text-step-0)] text-[var(--color-text-secondary)] leading-relaxed">
          {siteConfig.name} is your trusted <strong>pack & ship, printing, and business services store</strong> serving Concord Township, Painesville, Mentor, and all of Lake County, Ohio. Locally owned, faith-guided, and committed to our community.
        </p>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <p class="font-display text-[length:var(--text-step-1)] leading-tight font-bold text-[var(--color-text-primary)]">Contact</p>
        <div class="space-y-3">
          <div class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-[var(--color-accent-warm)] shrink-0" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <OutboundLink href="https://www.google.com/maps/dir/?api=1&destination=41.66497,-81.24164" class="motion-underline text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">
              {siteConfig.contact.address.street}, {siteConfig.contact.address.city}, {siteConfig.contact.address.state} {siteConfig.contact.address.zip}
            </OutboundLink>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-[var(--color-accent-warm)] shrink-0" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <a href={`tel:${phoneDigits}`} class="motion-underline text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">{siteConfig.contact.phone}</a>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-[var(--color-accent-warm)] shrink-0" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href={`mailto:${siteConfig.contact.email}`} class="motion-underline text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">{siteConfig.contact.email}</a>
          </div>
        </div>
      </div>

      <!-- Store Hours -->
      <div class="space-y-4">
        <p class="font-display text-[length:var(--text-step-1)] leading-tight font-bold text-[var(--color-text-primary)]">Store Hours</p>
        <div class="space-y-2 text-xl text-[var(--color-text-secondary)]">
          {Object.entries(siteConfig.hours).map(([day, hours]) => (
            <div  class="flex flex-wrap justify-between gap-x-3">
              <span class="capitalize whitespace-nowrap">{day.charAt(0).toUpperCase() + day.slice(1)}:</span>
              <span class="text-[var(--color-text-primary)] font-medium whitespace-nowrap">{hours as string}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Quick Links (spans two columns at lg+ so the 3-col grid has no empty cell) -->
      <div class="space-y-4 lg:col-span-2">
        <p class="font-display text-[length:var(--text-step-1)] leading-tight font-bold text-[var(--color-text-primary)]">Services</p>
        <nav class="lg:columns-2 lg:gap-x-12" aria-label="Footer Services">
          {quickLinks.map((link) => (
            <a  href={link.href} class="motion-underline block w-fit py-1 break-inside-avoid text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">{link.name}</a>
          ))}
        </nav>
      </div>

      <!-- Resources -->
      <div class="space-y-4">
        <p class="font-display text-[length:var(--text-step-1)] leading-tight font-bold text-[var(--color-text-primary)]">Resources</p>
        <nav aria-label="Footer Resources">
          <a href="/articles/" class="motion-underline block w-fit py-1 text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">Articles & Guides</a>
          <a href="/ask-mailbox-plus/" class="motion-underline block w-fit py-1 text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
      <div class="flex flex-col lg:flex-row justify-between items-center gap-4">
        <p class="text-xl text-[var(--color-text-secondary)] text-center">© 2025 Mailbox Plus of Ohio, LLC. All rights reserved.</p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          <a href="/accessibility/" class="motion-underline text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">Accessibility Statement</a>
          <a href="/privacy/" class="motion-underline text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">Privacy Policy</a>
          <a href="/terms/" class="motion-underline text-xl text-[var(--color-text-secondary)] hover:text-[var(--color-accent-warm)] transition-colors rounded-sm focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-warm)]">Terms of Service</a>
        </div>
      </div>

      <!-- Google Preferred Source Button -->
      <div class="mt-6 flex flex-col items-center gap-2">
        <p class="text-xl text-[var(--color-text-secondary)]">Add us as a preferred source on Google</p>
        <div google-add-preferred-source-btn>
          <span class="sr-only">Add Mailbox Plus as a preferred source on Google</span>
        </div>
      </div>
    </div>
  </div>
</footer>
