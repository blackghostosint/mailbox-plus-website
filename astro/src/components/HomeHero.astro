---
// HomeHero.astro — asymmetric two-column homepage hero (DESIGN_PHASE1_SPEC §3.1, §3.2, §4 Task 5).
//
// Invariants:
// - <h1> is the static LCP node: zero JS gate, zero entrance animation, server-rendered in markup.
// - Navy gradient with subtle depth (compositor-only animated gradient drift + SVG grain), zero photography.
// - Both CTAs sit fully above the fold at 1440×900 AND 390×844.
// - Review badge reuses ReviewSection.astro + reviews.json (single source of truth).
// - Monochrome carrier strip (UPS / FedEx / USPS / DHL) with screen-reader labels.
import ReviewSection from './ReviewSection.astro';
import CounterScene from './CounterScene.astro';
---

<section
  id="home-hero"
  aria-labelledby="hero-heading"
  class="relative overflow-hidden bg-gradient-to-br from-[var(--color-primary-dark)] via-[var(--color-primary)] to-[var(--color-primary-deep)] border-b border-white/10"
>
  <!-- Ambient depth wash (transform + opacity only; disabled under prefers-reduced-motion) -->
  <div
    aria-hidden="true"
    class="hero-ambient-gradient pointer-events-none absolute -inset-[18%]"
  ></div>

  <!-- Tactile print-shop micro-grain pattern (cached 24x24 SVG tile — zero feTurbulence CPU raster cost) -->
  <svg
    aria-hidden="true"
    focusable="false"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.06]"
  >
    <defs>
      <pattern id="hero-grain-pattern" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="3" cy="4" r="0.7" fill="white" />
        <circle cx="15" cy="2" r="0.6" fill="white" />
        <circle cx="9" cy="11" r="0.7" fill="white" />
        <circle cx="21" cy="13" r="0.6" fill="white" />
        <circle cx="5" cy="19" r="0.6" fill="white" />
        <circle cx="17" cy="21" r="0.7" fill="white" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grain-pattern)" />
  </svg>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-10 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Left Column: Eyebrow, Static LCP H1, Supporting Copy, Dual CTAs, Review Badge, Carrier Strip -->
      <div class="lg:col-span-7 text-left">
        <p class="hero-enter hero-enter-1 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-warm-on-dark)] mb-2.5 sm:mb-3">
          CONCORD TOWNSHIP, OH — PACK &amp; SHIP HUB
        </p>

        <h1
          id="hero-heading"
          class="font-display font-bold text-[length:var(--text-step-5)] text-white tracking-tight leading-[1.05] mb-3.5 sm:mb-4"
        >
          <span class="whitespace-nowrap">Four carriers.</span>{' '}
          <span class="whitespace-nowrap">One counter.</span>{' '}
          <span class="whitespace-nowrap">No runaround.</span>
        </h1>

        <p class="hero-enter hero-enter-2 text-[length:var(--text-step-0)] text-white/90 leading-snug sm:leading-relaxed max-w-xl mb-5 sm:mb-6">
          Shipping shouldn't cost you an hour. Stop running around Lake County for returns or carrier drop-offs.
        </p>

        <!-- Dual CTAs (both above the fold at 1440×900 and 390×844) -->
        <div
          data-hero-ctas
          class="hero-enter hero-enter-3 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-4 mb-5 sm:mb-6"
        >
          <a
            href="/pack-ship/package-drop-offs/"
            data-hero-cta="primary"
            class="motion-press inline-flex items-center justify-center gap-2 min-h-12 bg-[var(--color-accent-gold)] text-[var(--color-primary-deep)] font-bold text-base sm:text-lg px-6 py-3 rounded-md shadow-lg hover:bg-[var(--color-accent-gold-light)] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-gold-light)]"
          >
            Drop Off a Return
            <svg
              aria-hidden="true"
              focusable="false"
              class="w-5 h-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <a
            href="/private-mailbox-rental/"
            data-hero-cta="secondary"
            class="motion-press inline-flex items-center justify-center gap-2 min-h-12 border border-white/55 bg-white/10 text-white font-semibold text-base sm:text-lg px-6 py-3 rounded-md hover:bg-white/15 hover:border-[var(--color-accent-gold-light)] hover:text-[var(--color-accent-gold-light)] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-gold)]"
          >
            Rent a Mailbox
          </a>
        </div>

        <!-- Trust Signals: Live Google Review Badge + Monochrome Carrier Logos Strip -->
        <div class="hero-enter hero-enter-4 flex flex-col gap-3.5 pt-4 border-t border-white/20">
          <ReviewSection variant="badge" />

          <ul
            aria-label="Carriers accepted: UPS, FedEx, USPS, and DHL"
            data-hero-carriers
            class="flex flex-wrap items-center gap-x-4 sm:gap-x-6 gap-y-2 text-white/85"
          >
            <!-- UPS monochrome shield + wordmark -->
            <li class="inline-flex items-center">
              <span class="sr-only">UPS</span>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 62 28" class="h-6 sm:h-7 w-auto" fill="none">
                <path
                  d="M5 4.5H22V14.5C22 20 13.5 23.8 13.5 23.8C13.5 23.8 5 20 5 14.5V4.5Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
                <path d="M5 8.5Q13.5 6.2 22 8.5" stroke="currentColor" stroke-width="1.4" />
                <text
                  x="28"
                  y="19"
                  fill="currentColor"
                  font-family="var(--font-display)"
                  font-weight="700"
                  font-size="15.5"
                  letter-spacing="0.03em"
                >UPS</text>
              </svg>
            </li>

            <!-- FedEx monochrome geometric wordmark -->
            <li class="inline-flex items-center">
              <span class="sr-only">FedEx</span>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 68 28" class="h-6 sm:h-7 w-auto" fill="none">
                <text
                  x="1"
                  y="20"
                  fill="currentColor"
                  font-family="var(--font-display)"
                  font-weight="700"
                  font-size="18.5"
                  letter-spacing="-0.03em"
                >FedEx</text>
              </svg>
            </li>

            <!-- USPS monochrome sonic emblem + wordmark -->
            <li class="inline-flex items-center">
              <span class="sr-only">USPS</span>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 78 28" class="h-6 sm:h-7 w-auto" fill="none">
                <path
                  d="M3 7.5H20L17.2 20.5H2L4.8 7.5Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"
                />
                <path d="M7.2 13.5H18.2L13 16.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <text
                  x="25"
                  y="19.5"
                  fill="currentColor"
                  font-family="var(--font-display)"
                  font-weight="700"
                  font-size="16"
                  letter-spacing="0.04em"
                >USPS</text>
              </svg>
            </li>

            <!-- DHL monochrome speed-bars wordmark -->
            <li class="inline-flex items-center">
              <span class="sr-only">DHL</span>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 70 28" class="h-6 sm:h-7 w-auto" fill="none">
                <line x1="2" y1="11" x2="10" y2="11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <line x1="0.8" y1="15" x2="10" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <line x1="2" y1="19" x2="10" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <text
                  x="14"
                  y="19.5"
                  fill="currentColor"
                  font-family="var(--font-display)"
                  font-weight="700"
                  font-style="italic"
                  font-size="17"
                  letter-spacing="0.04em"
                >DHL</text>
                <line x1="56" y1="11" x2="65" y2="11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <line x1="56" y1="15" x2="67" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <line x1="56" y1="19" x2="65" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Bespoke Inline SVG Counter Scene -->
      <div class="hero-enter hero-enter-5 lg:col-span-5 w-full max-w-lg mx-auto lg:max-w-none" aria-hidden="true">
        <CounterScene />
      </div>
    </div>
  </div>
</section>

<script>
  import { scheduleHeroScene, type HeroSceneCleanup } from '../scripts/hero-scene';

  let cleanup: HeroSceneCleanup = () => {};

  const mount = () => {
    cleanup();
    cleanup = scheduleHeroScene(document);
  };

  // Run across both direct visits and ClientRouter View Transitions.
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    cleanup();
    cleanup = () => {};
  });
</script>
