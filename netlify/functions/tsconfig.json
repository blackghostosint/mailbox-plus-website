{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "vitest": ["../../astro/node_modules/vitest"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
